<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <SolidColorBrush x:Key="Bg"
                     Color="#F3F6FB" />
    <SolidColorBrush x:Key="Navy"
                     Color="#13233C" />
    <SolidColorBrush x:Key="Accent"
                     Color="#4169E1" />
    <SolidColorBrush x:Key="Muted"
                     Color="#718096" />

    <!-- Card -->
    <Style x:Key="Card"
           TargetType="Border">
        <Setter Property="Background"
                Value="White" />
        <Setter Property="CornerRadius"
                Value="16" />
        <Setter Property="Padding"
                Value="22" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="3"
                                  Opacity="0.07"
                                  Color="#1B3050" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Headings -->
    <Style x:Key="SectionTitle"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="17" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{StaticResource Navy}" />
    </Style>

    <Style x:Key="FieldLabel"
           TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="#66758B" />
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Margin"
                Value="0,0,0,7" />
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Padding"
                Value="12,10" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{StaticResource Navy}" />
        <Setter Property="Background"
                Value="#F9FBFE" />
        <Setter Property="BorderBrush"
                Value="#DCE5F1" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="MinHeight"
                Value="39" />
    </Style>

    <!-- Primary Button -->
    <Style x:Key="PrimaryButton"
           TargetType="Button">
        <Setter Property="Background"
                Value="{StaticResource Accent}" />
        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Padding"
                Value="18,11" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="MinHeight"
                Value="38" />
    </Style>

    <!-- Secondary Button -->
    <Style x:Key="SecondaryButton"
           TargetType="Button"
           BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background"
                Value="#EAF0FA" />
        <Setter Property="Foreground"
                Value="#344766" />
    </Style>

    <!-- Danger Button -->
    <Style x:Key="DangerButton"
           TargetType="Button"
           BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background"
                Value="#FDECEF" />
        <Setter Property="Foreground"
                Value="#C24154" />
    </Style>

    <!-- DataGrid -->
    <Style TargetType="DataGrid">
        <Setter Property="Background"
                Value="White" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="GridLinesVisibility"
                Value="None" />
        <Setter Property="HeadersVisibility"
                Value="Column" />
        <Setter Property="RowBackground"
                Value="White" />
        <Setter Property="AlternatingRowBackground"
                Value="#F7F9FD" />
        <Setter Property="RowHeight"
                Value="48" />
        <Setter Property="ColumnHeaderHeight"
                Value="42" />
        <Setter Property="HorizontalGridLinesBrush"
                Value="#EFF2F7" />
        <Setter Property="SelectionMode"
                Value="Single" />
        <Setter Property="SelectionUnit"
                Value="FullRow" />
        <Setter Property="AutoGenerateColumns"
                Value="False" />
        <Setter Property="CanUserAddRows"
                Value="False" />
        <Setter Property="IsReadOnly"
                Value="True" />
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Foreground"
                Value="{StaticResource Navy}" />
    </Style>

    <!-- DataGrid Header -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"
                Value="#F0F4FA" />
        <Setter Property="Foreground"
                Value="#63748B" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Padding"
                Value="12,0" />
        <Setter Property="MinWidth"
                Value="80" />
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="BorderThickness"
                Value="0" />
    </Style>

    <!-- DataGrid Cell -->
    <Style TargetType="DataGridCell">
        <Setter Property="Padding"
                Value="8,0" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
    </Style>

    <!-- DataGrid Row -->
    <Style TargetType="DataGridRow">
        <Setter Property="MinHeight"
                Value="48" />
        <Setter Property="Background"
                Value="White" />
        <Setter Property="Foreground"
                Value="#13233C" />
        <Setter Property="BorderThickness"
                Value="0" />

        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="#EDF3FF" />
            </Trigger>
            <Trigger Property="IsSelected"
                     Value="True">
                <Setter Property="Background"
                        Value="#DDEAFF" />
                <Setter Property="Foreground"
                        Value="#13233C" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
