<UserControl x:Class="SHBMS.View.BookingServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FB" FontFamily="Segoe UI">
    <UserControl.Resources><ResourceDictionary Source="ModernStyles.xaml"/></UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl"><Style.Triggers>
            <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
        </Style.Triggers></Style>
    </UserControl.Style>
    <Grid Margin="20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Booking services" FontSize="25" FontWeight="Bold" Foreground="#13233C"/>
            <TextBlock Text="Place service orders for customers. Charges are added after completion."
                       TextWrapping="Wrap" Foreground="#718096" Margin="0,5,0,10"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="10">
                <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" SelectionMode="Single" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="BOOKING" Binding="{Binding BookingId}" Width="90"/>
                        <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="*" MinWidth="135"/>
                        <DataGridTextColumn Header="SERVICE" Binding="{Binding ServiceName}" Width="*" MinWidth="140"/>
                        <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="55"/>
                        <DataGridTextColumn Header="UNIT PRICE" Binding="{Binding UnitPrice, StringFormat=N0}" Width="105"/>
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount, StringFormat=N0}" Width="105"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Service order" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="CHECKED-IN BOOKING" Style="{StaticResource FieldLabel}" Margin="0,15,0,6"/>
                        <ComboBox ItemsSource="{Binding Bookings}" SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
                                  IsEnabled="{Binding CanChooseService}" MinHeight="36">
                            <ComboBox.ItemTemplate><DataTemplate>
                                <TextBlock><Run Text="{Binding BookingId, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding Customer.FullName, Mode=OneWay}"/></TextBlock>
                            </DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="CUSTOMER" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                        <TextBlock Text="{Binding CustomerName}" Foreground="#13233C" TextWrapping="Wrap"/>
                        <TextBlock Text="SERVICE" Style="{StaticResource FieldLabel}" Margin="0,15,0,6"/>
                        <ComboBox ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                                  IsEnabled="{Binding CanChooseService}" MinHeight="36">
                            <ComboBox.ItemTemplate><DataTemplate>
                                <TextBlock><Run Text="{Binding ServiceName, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding UnitPrice, Mode=OneWay, StringFormat={}{0:N0} VND}"/></TextBlock>
                            </DataTemplate></ComboBox.ItemTemplate>
                            <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Style.Triggers>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="IsEnabled" Value="False"/><Setter Property="Foreground" Value="#94A3B8"/></DataTrigger>
                                <DataTrigger Binding="{Binding StockQuantity}" Value="0"><Setter Property="IsEnabled" Value="False"/><Setter Property="Foreground" Value="#94A3B8"/></DataTrigger>
                            </Style.Triggers></Style></ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <TextBlock Text="QUANTITY" Style="{StaticResource FieldLabel}" Margin="0,15,0,6"/>
                        <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" IsEnabled="{Binding CanEditOrder}"/>
                        <TextBlock Text="NOTE (OPTIONAL)" Style="{StaticResource FieldLabel}" Margin="0,15,0,6"/>
                        <TextBox Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="85" VerticalScrollBarVisibility="Auto" MaxLength="500" IsEnabled="{Binding CanEditOrder}"/>
                        <TextBlock Text="{Binding SelectionHint}" TextWrapping="Wrap" Foreground="#718096" Margin="0,12,0,8"/>
                        <TextBlock Text="Existing booking services keep their agreed unit prices." TextWrapping="Wrap" Foreground="#718096" FontSize="11" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Width="140" HorizontalAlignment="Left" Margin="0,0,6,8"/>
                            <Button Content="Save order" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Width="140" HorizontalAlignment="Right" Margin="0,0,6,8"/>
                          
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
