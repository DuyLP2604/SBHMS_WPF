<UserControl x:Class="SHBMS.View.InvoiceManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FB" FontFamily="Segoe UI">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

<UserControl.Resources><ResourceDictionary Source="ModernStyles.xaml" /></UserControl.Resources>
<Grid Margin="20,16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,12">
<TextBlock Text="Invoices" FontSize="25" FontWeight="Bold" Foreground="#13233C" />
<TextBlock Text="View invoices stored in the database." TextWrapping="Wrap" Foreground="#718096" Margin="0,5,0,0" />
<TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#B45309" Margin="0,6,0,0" />
</StackPanel>
<WrapPanel Grid.Row="1" Margin="0,0,0,12"><Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" /></WrapPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*" MinWidth="235"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Padding="12"><DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
<DataGrid.Columns><DataGridTextColumn Header="INVOICE" Binding="{Binding InvoiceId}" Width="95" MinWidth="85" /><DataGridTextColumn Header="BOOKING" Binding="{Binding BookingId}" Width="95" MinWidth="85" /><DataGridTextColumn Header="CUSTOMER" Binding="{Binding Booking.Customer.FullName}" Width="*" MinWidth="85" /><DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount}" Width="120" MinWidth="85" /></DataGrid.Columns></DataGrid></Border>
<Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="INVOICE" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" /><TextBlock Text="{Binding SelectedInvoice.InvoiceId}" TextWrapping="Wrap" Foreground="#13233C" FontSize="14" /><TextBlock Text="BOOKING" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" /><TextBlock Text="{Binding SelectedInvoice.BookingId}" TextWrapping="Wrap" Foreground="#13233C" FontSize="14" /><TextBlock Text="ISSUED AT" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" /><TextBlock Text="{Binding SelectedInvoice.InvoiceDate}" TextWrapping="Wrap" Foreground="#13233C" FontSize="14" /><TextBlock Text="CUSTOMER" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" /><TextBlock Text="{Binding SelectedInvoice.Booking.Customer.FullName}" TextWrapping="Wrap" Foreground="#13233C" FontSize="14" /><TextBlock Text="ROOMS" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" /><TextBlock Text="{Binding RoomText}" TextWrapping="Wrap" Foreground="#13233C" FontSize="14" /><TextBlock Text="STAY PERIOD" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" /><TextBlock Text="{Binding StayPeriod}" TextWrapping="Wrap" Foreground="#13233C" FontSize="14" /><TextBlock Text="SERVICES" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" /><TextBlock Text="{Binding ServiceText}" TextWrapping="Wrap" Foreground="#13233C" FontSize="14" /><TextBlock Text="TOTAL AMOUNT" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" /><TextBlock Text="{Binding SelectedInvoice.TotalAmount}" TextWrapping="Wrap" Foreground="#13233C" FontSize="14" /></StackPanel></ScrollViewer></Border></Grid>
</Grid></UserControl>
