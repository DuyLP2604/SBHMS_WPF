<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="SHBMS.View.InvoiceManager"
    Background="#F3F6FB" FontFamily="Segoe UI" Width="824" d:DesignHeight="524.24">

    <UserControl.Resources>
        <ResourceDictionary Source="ModernStyles.xaml" />
    </UserControl.Resources>

    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid Margin="20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Invoices" FontSize="26" FontWeight="Bold" Foreground="#1A2B4C"/>
            <TextBlock Text="View invoices stored in the database." FontSize="14" Foreground="#7A869A" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Nút Refresh -->
            <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCmd}" 
                    Width="100" Height="35" Background="#E2E8F0" Foreground="#1A2B4C" 
                    FontWeight="SemiBold" HorizontalAlignment="Right" BorderThickness="0" Cursor="Hand"/>

            <TextBlock Grid.Column="0" Text="Search by Customer Name:" VerticalAlignment="Center" 
                       Foreground="#1A2B4C" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"/>

            <TextBox Grid.Column="0" Height="35" VerticalContentAlignment="Center" Padding="10,0"
                     Text="{Binding searchtext, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" 
                     Background="White" BorderBrush="#CBD5E1" BorderThickness="1" 
                     ToolTip="Search by Customer Name" Grid.ColumnSpan="2" Margin="197,0,0,0"/>

            <Button Grid.Column="2" Content="Search" Command="{Binding SearchCmd}" 
                    Width="80" Height="35" Background="#87CEEB" Foreground="#1A2B4C" 
                    FontWeight="SemiBold" HorizontalAlignment="Left" BorderThickness="0" Cursor="Hand"
                    Margin="10,2,0,2"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- datagrid of left -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,15,0" 
                    BorderBrush="#E2E8F0" BorderThickness="1">

                <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice, Mode=OneWayToSource}" 
                          AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="None">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="INVOICE" Binding="{Binding InvoiceId}" Width="80"/>
                        <DataGridTextColumn Header="BOOKING" Binding="{Binding BookingId}" Width="80"/>
                        <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Invoice details -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" 
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="INVOICE" FontWeight="SemiBold" Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="{Binding selectedItem.InvoiceId}" FontSize="14" Foreground="#1A2B4C" Margin="0,5,0,15"/>

                    <TextBlock Text="BOOKING" FontWeight="SemiBold" Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="{Binding selectedItem.BookingId}" FontSize="14" Foreground="#1A2B4C" Margin="0,5,0,15"/>

                    <TextBlock Text="ISSUED AT" FontWeight="SemiBold" Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="{Binding selectedItem.InvoiceDate, StringFormat=dd/MM/yyyy HH:mm}" FontSize="14" Foreground="#1A2B4C" Margin="0,5,0,15"/>

                    <TextBlock Text="CUSTOMER" FontWeight="SemiBold" Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="{Binding selectedItem.CustomerName}" FontSize="14" Foreground="#1A2B4C" Margin="0,5,0,15"/>

                    <TextBlock Text="ROOMS" FontWeight="SemiBold" Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="{Binding selectedItem.Rooms}" FontSize="14" Foreground="#1A2B4C" Margin="0,5,0,15" TextWrapping="Wrap"/>

                    <TextBlock Text="STAY PERIOD" FontWeight="SemiBold" Foreground="#64748B" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                        <TextBlock Text="{Binding selectedItem.CheckinDate, StringFormat=dd/MM/yyyy}" FontSize="14" Foreground="#1A2B4C"/>
                        <TextBlock Text=" - " FontSize="14" Foreground="#1A2B4C"/>
                        <TextBlock Text="{Binding selectedItem.CheckoutDate, StringFormat=dd/MM/yyyy}" FontSize="14" Foreground="#1A2B4C"/>
                    </StackPanel>

                    <TextBlock Text="SERVICES" FontWeight="SemiBold" Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="{Binding selectedItem.Services}" FontSize="14" Foreground="#1A2B4C" Margin="0,5,0,15" TextWrapping="Wrap"/>

                    <TextBlock Text="TOTAL AMOUNT" FontWeight="SemiBold" Foreground="#64748B" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                        <TextBlock Text="{Binding selectedItem.TotalAmount}" FontSize="16" FontWeight="Bold" Foreground="#1A2B4C"/>
                        <TextBlock Text=" VND" FontSize="16" FontWeight="Bold" Foreground="#1A2B4C" Margin="4,0,0,0"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>