<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SHBMS.View.RoomTypesView" Background="{DynamicResource Bg}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid Margin="20,14" Visibility="{Binding CanView, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="125"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Room types" Foreground="{StaticResource Navy}" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="Manage room categories, capacity and nightly prices." Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding AccessHint}" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="152"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" Margin="0,0,12,10">
                        <TextBlock Text="ROOM TYPE ID" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding RoomTypeId, Mode=OneWay}" MaxLength="4" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Margin="0,0,12,10">
                        <TextBlock Text="TYPE NAME *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding TypeName, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" IsReadOnly="{Binding IsReadOnly}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="1" Margin="0,0,12,10">
                        <TextBlock Text="CAPACITY *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CapacityText, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" IsReadOnly="{Binding IsReadOnly}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1" Margin="0,0,12,10">
                        <TextBlock Text="PRICE / NIGHT (VND) *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" IsReadOnly="{Binding IsReadOnly}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,12,10">
                        <TextBlock Text="DESCRIPTION" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" MaxLength="500" Height="65" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10,6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Grid.RowSpan="2" Margin="0,0,0,6">
                        <Border Height="118" Background="{StaticResource Bg}" CornerRadius="10">
                            <Grid>
                                <Image Source="{Binding ImagePreview}" Stretch="Uniform" Margin="5"/>
                                <TextBlock Text="No image" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <WrapPanel Margin="0,8,0,0" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="Choose" Command="{Binding ChooseImageCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,8" VerticalAlignment="Bottom"/>
                            <Button Content="Clear" Command="{Binding ClearImageCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,8" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
                <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,8" VerticalAlignment="Bottom"/>
                    <Button Content="Add" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="14,8" VerticalAlignment="Bottom"/>
                    <Button Content="Update" Command="{Binding UpdateCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="14,8" VerticalAlignment="Bottom"/>
                    <Button Content="Delete" Command="{Binding DisableCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Padding="14,8" VerticalAlignment="Bottom"/>
                </WrapPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="SEARCH" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type ID, name or description" Width="180"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="MIN CAPACITY" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding MinimumCapacityText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional" Width="105"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="MAX PRICE (VND)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding MaximumPriceText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional" Width="140"/>
                </StackPanel>
                <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="14,8" VerticalAlignment="Bottom"/>
                <Button Content="Reset" Command="{Binding ResetFiltersCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,8" VerticalAlignment="Bottom"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,8" VerticalAlignment="Bottom"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding RoomTypesView}" SelectedItem="{Binding SelectedRoomType, Mode=TwoWay}" CanUserReorderColumns="False" CanUserDeleteRows="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding RoomTypeId}" Width="80" MinWidth="65"/>
                        <DataGridTextColumn Header="TYPE NAME" Binding="{Binding Name}" Width="*" MinWidth="160"/>
                        <DataGridTextColumn Header="CAPACITY" Binding="{Binding Capacity}" Width="90" MinWidth="85"/>
                        <DataGridTextColumn Header="PRICE / NIGHT" Binding="{Binding BasePrice, StringFormat=N2}" Width="120" MinWidth="110"/>
                        <DataGridTextColumn Header="ROOMS" Binding="{Binding RoomCount}" Width="85" MinWidth="75"/>
                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" MinWidth="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
