<UserControl x:Class="SHBMS.View.RoomTypesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><ResourceDictionary Source="OperationsStyles.xaml"/></UserControl.Resources>
    <Grid Margin="24,14,24,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="Room types" FontSize="26" FontWeight="SemiBold" Foreground="#13233C"/><TextBlock Text="Room categories, capacity and nightly prices" Style="{StaticResource SmallMuted}" Margin="0,5,0,20"/></StackPanel><Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}"/></Grid>
        <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search room type name or ID"/>
        <StackPanel Grid.Row="2"><TextBlock Style="{StaticResource OperationMessage}"/><ProgressBar Style="{StaticResource BusyIndicator}"/><TextBlock Text="{Binding TypeCount, StringFormat={}{0} room types shown}" Style="{StaticResource SmallMuted}" Margin="0,0,0,10"/></StackPanel>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="12" Padding="6"><DataGrid ItemsSource="{Binding RoomTypes}" SelectedItem="{Binding SelectedRoomType}"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding RoomTypeId}" Width="70"/><DataGridTextColumn Header="Type" Binding="{Binding Name}" Width="*" MinWidth="130"/><DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" Width="80"/><DataGridTextColumn Header="Price / night" Binding="{Binding BasePrice, StringFormat=N0}" Width="125"/><DataGridTextColumn Header="Rooms" Binding="{Binding TotalRooms}" Width="75"/><DataGridTextColumn Header="Booking refs" Binding="{Binding BookingReferences}" Width="100"/></DataGrid.Columns></DataGrid></Border>
                <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,12,0,0"><TextBlock Text="{Binding SelectedTypeDescription}" Style="{StaticResource SmallMuted}"/></Border>
            </Grid>
            <Border Grid.Column="1" Width="285" Background="White" CornerRadius="12" Padding="19" Visibility="{Binding CanManage, Converter={StaticResource BoolVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>
                    <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource NotBusy}}">
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Margin="0,0,0,13"/>
                        <TextBlock Text="Capacity" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CapacityText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,13"/>
                        <TextBlock Text="Price per night (VND)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,13"/>
                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="105" MaxLength="500" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>
                    </StackPanel>
                    <UniformGrid Columns="2"><Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,7,0"/><Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/></UniformGrid>
                    <Button Content="Delete selected type" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,10,0,12"/>
                    <TextBlock Text="Deletion is available only when no room or booking history references this type. Prices already stored in bookings are retained." Style="{StaticResource SmallMuted}"/>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
