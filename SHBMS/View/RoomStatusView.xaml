<UserControl x:Class="SHBMS.View.RoomStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FB"
             FontFamily="Segoe UI"
             IsVisibleChanged="View_IsVisibleChanged">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Small summary card -->
            <Style x:Key="StatCard"
                   TargetType="Border"
                   BasedOn="{StaticResource Card}">
                <Setter Property="Padding"
                        Value="16,12" />
            </Style>

            <!-- Room tile container: selection / hover outline, no default blue highlight -->
            <Style x:Key="RoomTileContainer"
                   TargetType="ListBoxItem">
                <Setter Property="Margin"
                        Value="0,0,12,12" />
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Frame"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    CornerRadius="14"
                                    Padding="2">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="Frame"
                                            Property="BorderBrush"
                                            Value="#B8C8F0" />
                                </Trigger>
                                <Trigger Property="IsSelected"
                                         Value="True">
                                    <Setter TargetName="Frame"
                                            Property="BorderBrush"
                                            Value="#4169E1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <DockPanel Grid.Row="0"
                   Margin="0,0,0,10">

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock x:Name="LastRefreshText"
                           Foreground="#718096"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <Button Content="Refresh"
                        Style="{StaticResource SecondaryButton}"
                        Padding="14,7"
                        Click="Refresh_Click" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="ROOM OPERATIONS"
                           Foreground="#4169E1"
                           FontWeight="Bold"
                           FontSize="10" />

                <TextBlock Text="Room status"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#13233C"
                           Margin="0,2,0,2" />

                <TextBlock Text="Live view of every room. Select a room to see who is staying and to change its availability."
                           FontSize="12"
                           Foreground="#718096" />
            </StackPanel>
        </DockPanel>

        <!-- SUMMARY -->
        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0,0,0,10">

            <Border Style="{StaticResource StatCard}"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock x:Name="AvailableCount"
                               Text="0"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#167A4B" />
                    <TextBlock Text="Available"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock x:Name="OccupiedCount"
                               Text="0"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#2F54C8" />
                    <TextBlock Text="Occupied"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock x:Name="MaintenanceCount"
                               Text="0"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#B7791F" />
                    <TextBlock Text="Maintenance"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock x:Name="InactiveCount"
                               Text="0"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#6B7686" />
                    <TextBlock Text="Inactive"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- BOARD + DETAILS -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- ROOM BOARD -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="14">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filters -->
                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,12">

                        <TextBlock x:Name="ResultText"
                                   DockPanel.Dock="Right"
                                   Foreground="#8793A6"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />

                        <WrapPanel Orientation="Horizontal">
                            <TextBox x:Name="SearchBox"
                                     Width="190"
                                     Height="35"
                                     Margin="0,0,8,4"
                                     ToolTip="Search by room number or guest name"
                                     TextChanged="Filter_Changed" />

                            <ComboBox x:Name="StatusFilter"
                                      Width="150"
                                      Height="35"
                                      Margin="0,0,8,4"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="Filter_Changed" />

                            <ComboBox x:Name="TypeFilter"
                                      Width="150"
                                      Height="35"
                                      Margin="0,0,0,4"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="Filter_Changed" />
                        </WrapPanel>
                    </DockPanel>

                    <!-- Room tiles -->
                    <ListBox x:Name="RoomList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource RoomTileContainer}"
                             SelectionChanged="RoomList_SelectionChanged">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="156"
                                        Height="112"
                                        CornerRadius="12"
                                        Padding="14,12">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="#EAF7F0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DisplayStatus}"
                                                             Value="Occupied">
                                                    <Setter Property="Background"
                                                            Value="#E8EFFF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DisplayStatus}"
                                                             Value="Maintenance">
                                                    <Setter Property="Background"
                                                            Value="#FFF4DD" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DisplayStatus}"
                                                             Value="Inactive">
                                                    <Setter Property="Background"
                                                            Value="#EEF0F4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding DisplayStatus}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="#167A4B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DisplayStatus}"
                                                                         Value="Occupied">
                                                                <Setter Property="Foreground"
                                                                        Value="#2F54C8" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DisplayStatus}"
                                                                         Value="Maintenance">
                                                                <Setter Property="Foreground"
                                                                        Value="#B7791F" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DisplayStatus}"
                                                                         Value="Inactive">
                                                                <Setter Property="Foreground"
                                                                        Value="#6B7686" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Text="{Binding RoomNumber}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="#13233C" />
                                        </DockPanel>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding RoomTypeName}"
                                                   FontSize="12"
                                                   Foreground="#66758B" />

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding TileNote}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#344766"
                                                   VerticalAlignment="Bottom"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ROOM DETAILS -->
            <Border Grid.Column="1"
                    Style="{StaticResource Card}"
                    Padding="20"
                    Margin="12,0,0,0">

                <Grid>
                    <TextBlock x:Name="EmptyDetail"
                               Text="Select a room to see its details and update its availability."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="#8793A6"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <ScrollViewer x:Name="DetailPanel"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <StackPanel>

                            <TextBlock Text="ROOM"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,2" />

                            <TextBlock x:Name="DetailRoomNumber"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#13233C" />

                            <TextBlock x:Name="DetailTypeText"
                                       FontSize="12"
                                       Foreground="#66758B"
                                       Margin="0,2,0,0" />

                            <Border x:Name="DetailStatusPill"
                                    CornerRadius="12"
                                    Padding="10,4"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,16">
                                <TextBlock x:Name="DetailStatusText"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Rate"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0" />
                                <TextBlock x:Name="DetailRate"
                                           Grid.Column="1"
                                           FontSize="13"
                                           Foreground="#13233C" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Current guest"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0" />
                                <TextBlock x:Name="DetailGuest"
                                           Grid.Column="1"
                                           FontSize="13"
                                           Foreground="#13233C"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Expected check-out"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0" />
                                <TextBlock x:Name="DetailCheckOut"
                                           Grid.Column="1"
                                           FontSize="13"
                                           Foreground="#13233C" />
                            </Grid>

                            <Border Height="1"
                                    Background="#E8EDF5"
                                    Margin="0,8,0,16" />

                            <TextBlock Text="UPDATE AVAILABILITY"
                                       Style="{StaticResource FieldLabel}" />

                            <ComboBox x:Name="NewStatusCombo"
                                      Height="38"
                                      VerticalContentAlignment="Center" />

                            <TextBlock x:Name="StatusHint"
                                       FontSize="11"
                                       Foreground="#8793A6"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,14" />

                            <Button x:Name="UpdateStatusButton"
                                    Content="Update status"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="UpdateStatus_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
