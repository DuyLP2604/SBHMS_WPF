<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="BindingResources.xaml" />
        <ResourceDictionary Source="ModernStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="9,6"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DatePicker"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="4"/><Setter Property="FontSize" Value="12"/><Setter Property="SelectedDateFormat" Value="Short"/></Style>
    <Style x:Key="OperationMessage" TargetType="TextBlock">
        <Setter Property="Text" Value="{Binding Message}"/><Setter Property="Foreground" Value="#18764F"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,8"/>
        <Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="#B43848"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="BusyIndicator" TargetType="ProgressBar"><Setter Property="Height" Value="3"/><Setter Property="IsIndeterminate" Value="True"/><Setter Property="Foreground" Value="#4169E1"/><Setter Property="Margin" Value="0,4"/><Setter Property="Visibility" Value="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/></Style>
    <Style x:Key="SmallMuted" TargetType="TextBlock"><Setter Property="Foreground" Value="#718096"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="DetailLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#718096"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
    <Style x:Key="DetailValue" TargetType="TextBlock"><Setter Property="Foreground" Value="#13233C"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
</ResourceDictionary>
