<UserControl x:Class="SHBMS.View.CheckInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid Margin="20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="140"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Check-in" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Navy}"/>
            <TextBlock Text="Check in on the arrival date at any time. Collect the full room charge before check-in."
                       Foreground="{StaticResource Muted}" Margin="0,4,0,10" TextWrapping="Wrap"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by booking ID, customer name or phone"/>
            </DockPanel>
            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding SelectionHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <DataGrid ItemsSource="{Binding BookingsView}" SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
                      CanUserDeleteRows="False">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ToolTip" Value="{Binding CheckInDate, StringFormat='Check-in date: {0:dd/MM/yyyy} (any time)'}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCheckInOverdue}" Value="True">
                                <Setter Property="Background" Value="#FFF1F2"/>
                                <Setter Property="Foreground" Value="#B91C1C"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsCheckInOverdue}" Value="True"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#FECDD3"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="BOOKING" Binding="{Binding BookingId}" Width="90"/>
                    <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="*" MinWidth="130"/>
                    <DataGridTextColumn Header="PHONE" Binding="{Binding CustomerPhone}" Width="110"/>
                    <DataGridTextColumn Header="ARRIVAL" Binding="{Binding CheckInDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="DEPARTURE" Binding="{Binding CheckOutDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="ROOMS" Binding="{Binding TotalRooms}" Width="65"/>
                    <DataGridTemplateColumn Header="ACTION" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Cancel"
                                        Command="{Binding DataContext.CancelNoShowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" Padding="12,6" VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsCheckInOverdue}" Value="True"/>
                                                        <Condition Binding="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Assign rooms" Command="{Binding OpenAssignCommand}" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/>
            <Border Background="#FFF1F2" BorderBrush="#FDA4AF" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,8"
                    Visibility="{Binding IsCancelling, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding BookingToCancel.BookingId, StringFormat='Cancel overdue booking {0}?'}" FontWeight="SemiBold" Foreground="#B91C1C"/>
                    <TextBlock Text="The booking will be marked CANCELLED. Its payment history will be kept; no refund is created."
                               TextWrapping="Wrap" Margin="0,6,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Keep booking" Command="{Binding KeepBookingCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Confirm cancel" Command="{Binding ConfirmCancelCommand}" Style="{StaticResource DangerButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16"
                    Visibility="{Binding IsAssigning, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Assign rooms and collect payment" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding SelectedBooking.BookingId}" Foreground="{StaticResource Accent}" Margin="0,4,0,8"/>
                        <UniformGrid Columns="3" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="ROOM CHARGE (VND)" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding SelectedBooking.RoomSubtotal, StringFormat=N0}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="ALREADY PAID (VND)" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding SelectedBooking.PaidAmount, StringFormat=N0}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="ROOM AMOUNT DUE (VND)" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding AmountDue, StringFormat=N0}" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="18"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Pay the remaining room charge in cash. Service charges are settled at checkout."
                                   TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding RoomAssignments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                        <!-- Each row owns its own list and selected room ID. -->
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableRooms}"
                                                  DisplayMemberPath="RoomNumber" SelectedValuePath="RoomId"
                                                  SelectedValue="{Binding SelectedRoomId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  MinHeight="36" IsEditable="False"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox IsChecked="{Binding CashReceived, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding HasAmountDue, Converter={StaticResource BoolToVisibility}}"
                                  Margin="0,6,0,4">
                            <TextBlock Text="I have received the full remaining room payment in cash. Check-in will record this payment."
                                       TextWrapping="Wrap"/>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Cancel" Command="{Binding CancelAssignCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Check in" Command="{Binding CheckInCommand}" Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
