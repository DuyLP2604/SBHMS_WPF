<UserControl x:Class="SHBMS.View.ServiceRequestsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FB" FontFamily="Segoe UI">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

<UserControl.Resources><ResourceDictionary Source="ModernStyles.xaml" /></UserControl.Resources>
<Grid Margin="20,16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,12">
<TextBlock Text="Booking services" FontSize="25" FontWeight="Bold" Foreground="#13233C" />
<TextBlock Text="Manage service quantities and charges. Request workflow statuses are currently unavailable." TextWrapping="Wrap" Foreground="#718096" Margin="0,5,0,0" />
<TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#B45309" Margin="0,6,0,0" />
</StackPanel>
<WrapPanel Grid.Row="1" Margin="0,0,0,12"><Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" /></WrapPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*" MinWidth="235"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Padding="12"><DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
<DataGrid.Columns><DataGridTextColumn Header="BOOKING" Binding="{Binding BookingId}" Width="95" MinWidth="85" /><DataGridTextColumn Header="SERVICE" Binding="{Binding Service.ServiceName}" Width="*" MinWidth="85" /><DataGridTextColumn Header="QUANTITY" Binding="{Binding Quantity}" Width="95" MinWidth="85" /><DataGridTextColumn Header="UNIT PRICE" Binding="{Binding UnitPrice}" Width="110" MinWidth="85" /></DataGrid.Columns></DataGrid></Border>
<Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Service order" Style="{StaticResource SectionTitle}" /><TextBlock Text="CHECKED-IN BOOKING" Style="{StaticResource FieldLabel}" Margin="0,15,0,6" /><ComboBox ItemsSource="{Binding Bookings}" SelectedItem="{Binding SelectedBooking}" DisplayMemberPath="BookingId" IsEnabled="{Binding IsNew}" Height="36" /><TextBlock Text="SELECTED BOOKING" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" /><TextBlock Text="{Binding SelectedOrder.BookingId}" TextWrapping="Wrap" Foreground="#13233C" FontSize="14" /><TextBlock Text="SERVICE" Style="{StaticResource FieldLabel}" Margin="0,15,0,6" /><ComboBox ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" DisplayMemberPath="ServiceName" IsEnabled="{Binding IsNew}" Height="36" /><TextBlock Text="QUANTITY" Style="{StaticResource FieldLabel}" Margin="0,15,0,6" /><TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" Margin="0,0,0,16" /><WrapPanel><Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" /><Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" /><Button Content="Remove" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,0" /></WrapPanel></StackPanel></ScrollViewer></Border></Grid>
</Grid></UserControl>
