<UserControl x:Class="SHBMS.View.ServiceRequestsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F6FB"
    FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary Source="ModernStyles.xaml"/>
    </UserControl.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Service Requests"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#13233C"/>

            <TextBlock
                Text="Manage and process guest service requests."
                Foreground="#718096"
                Margin="0,5,0,0"/>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#B45309"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- SEARCH / FILTER -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="12"
                Margin="0,0,0,12">

            <DockPanel>
                <Button Content="Refresh"
                        DockPanel.Dock="Right"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"/>

                <StackPanel Orientation="Horizontal">
                    <TextBox Width="210"
                             Margin="0,0,10,0"
                             Text="{Binding SearchText,
                             UpdateSourceTrigger=PropertyChanged}"/>

                    <ComboBox Width="135"
                              ItemsSource="{Binding Filters}"
                              SelectedItem="{Binding StatusFilter}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"
                                  MinWidth="270"/>
            </Grid.ColumnDefinitions>

            <!-- REQUEST LIST -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Service Request List"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,14"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Requests}"
                              SelectedItem="{Binding SelectedRequest,
                                  Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="ID"
                                Binding="{Binding Id}"
                                Width="55"/>

                            <DataGridTextColumn
                                Header="BOOKING"
                                Binding="{Binding BookingId}"
                                Width="90"/>

                            <DataGridTextColumn
                                Header="SERVICE"
                                Binding="{Binding ServiceName}"
                                Width="130"/>

                            <DataGridTextColumn
                                Header="DETAILS"
                                Binding="{Binding Details}"
                                Width="*"
                                MinWidth="140"/>

                            <DataGridTextColumn
                                Header="STATUS"
                                Binding="{Binding Status}"
                                Width="110"/>

                            <DataGridTextColumn
                                Header="CREATED"
                                Binding="{Binding CreatedAt,
                                    StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- REQUEST FORM -->
            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="16">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto">

                    <StackPanel>
                        <TextBlock
                            Text="New Service Request"
                            Style="{StaticResource SectionTitle}"/>

                        <TextBlock
                            Text="CHECKED-IN BOOKING"
                            Style="{StaticResource FieldLabel}"
                            Margin="0,15,0,6"/>

                        <ComboBox Height="36"
                            ItemsSource="{Binding Bookings}"
                            SelectedItem="{Binding SelectedBooking,
                                Mode=TwoWay}"
                            DisplayMemberPath="BookingId"/>

                        <TextBlock
                            Text="SERVICE"
                            Style="{StaticResource FieldLabel}"
                            Margin="0,15,0,6"/>

                        <ComboBox Height="36"
                            ItemsSource="{Binding Services}"
                            SelectedItem="{Binding SelectedService,
                                Mode=TwoWay}"
                            DisplayMemberPath="ServiceName"/>

                        <TextBlock
                            Text="REQUEST DETAILS"
                            Style="{StaticResource FieldLabel}"
                            Margin="0,15,0,6"/>

                        <TextBox Height="90"
                            Text="{Binding Details,
                                UpdateSourceTrigger=PropertyChanged}"
                            MaxLength="500"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"/>

                        <WrapPanel Margin="0,15,0,0">
                            <Button Content="New"
                                Command="{Binding NewCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"/>

                            <Button Content="Create Request"
                                Command="{Binding CreateCommand}"
                                Style="{StaticResource PrimaryButton}"/>
                        </WrapPanel>

                        <Separator Margin="0,20,0,18"/>

                        <!-- PROCESS REQUEST -->
                        <TextBlock
                            Text="Process Request"
                            Style="{StaticResource SectionTitle}"/>

                        <TextBlock
                            Text="SELECTED BOOKING"
                            Style="{StaticResource FieldLabel}"
                            Margin="0,15,0,6"/>

                        <TextBlock
                            Text="{Binding SelectedRequest.BookingId,
                                TargetNullValue=No request selected}"
                            Foreground="#13233C"/>

                        <TextBlock
                            Text="REQUEST DETAILS"
                            Style="{StaticResource FieldLabel}"
                            Margin="0,15,0,6"/>

                        <TextBlock
                            Text="{Binding SelectedRequest.Details}"
                            TextWrapping="Wrap"
                            Foreground="#13233C"/>

                        <TextBlock
                            Text="CURRENT STATUS"
                            Style="{StaticResource FieldLabel}"
                            Margin="0,15,0,6"/>

                        <TextBlock
                            Text="{Binding SelectedRequest.Status}"
                            Foreground="#4169E1"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="UPDATE STATUS"
                            Style="{StaticResource FieldLabel}"
                            Margin="0,15,0,6"/>

                        <ComboBox Height="36"
                            ItemsSource="{Binding Statuses}"
                            SelectedItem="{Binding SelectedStatus,
                                Mode=TwoWay}"/>

                        <Button Content="Update Status"
                            Command="{Binding UpdateStatusCommand}"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left"
                            Margin="0,15,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
