<UserControl x:Class="SHBMS.View.ServiceRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FB"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="HOTEL OPERATIONS" Foreground="#4169E1" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="Booking services" FontSize="25" FontWeight="Bold"
                       Foreground="#13233C" Margin="0,2,0,2" />
            <TextBlock Text="Manage service quantities and charges for checked-in bookings."
                       FontSize="12" Foreground="#718096" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Refresh" Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}" />

            <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" FontSize="12"
                       Foreground="#4169E1" VerticalAlignment="Center" Margin="14,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,14,0">
                <DataGrid ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="BOOKING" Binding="{Binding BookingId}" Width="100" />
                        <DataGridTextColumn Header="SERVICE" Binding="{Binding Service.ServiceName}" Width="*" />
                        <DataGridTextColumn Header="QUANTITY" Binding="{Binding Quantity}" Width="90" />
                        <DataGridTextColumn Header="UNIT PRICE" Binding="{Binding UnitPrice, StringFormat=N0}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Service order" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                        <TextBlock Text="CHECKED-IN BOOKING" Style="{StaticResource FieldLabel}" />

                        <ComboBox Height="38" VerticalContentAlignment="Center" Margin="0,0,0,12"
                                  ItemsSource="{Binding Bookings}"
                                  SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
                                  IsEnabled="{Binding IsNew, Mode=OneWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding BookingId, Mode=OneWay}" />
                                        <Run Text="  ·  " Foreground="#8793A6" />
                                        <Run Text="{Binding CustomerId, Mode=OneWay}" Foreground="#8793A6" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="SELECTED BOOKING" Style="{StaticResource FieldLabel}" />

                        <TextBlock FontWeight="SemiBold" Foreground="#13233C" MinHeight="20" Margin="0,0,0,12">
                            <Run Text="{Binding SelectedBooking.BookingId, Mode=OneWay, FallbackValue=—}" />
                            <Run Text="  ·  " Foreground="#8793A6" />
                            <Run Text="{Binding SelectedBooking.CustomerId, Mode=OneWay}" Foreground="#8793A6" />
                        </TextBlock>

                        <TextBlock Text="SERVICE" Style="{StaticResource FieldLabel}" />

                        <ComboBox Height="38" VerticalContentAlignment="Center" Margin="0,0,0,12"
                                  ItemsSource="{Binding Services}"
                                  SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                                  IsEnabled="{Binding IsNew, Mode=OneWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding ServiceName, Mode=OneWay}" />
                                        <Run Text="  ·  " Foreground="#8793A6" />
                                        <Run Text="{Binding UnitPrice, Mode=OneWay, StringFormat=N0}" Foreground="#8793A6" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="QUANTITY" Style="{StaticResource FieldLabel}" />
                        <TextBox Height="38" Margin="0,0,0,16"
                                 Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <UniformGrid Rows="1">
                            <Button Content="New" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding NewCommand}" Margin="0,0,6,0" />
                            <Button Content="Save" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveCommand}" Margin="3,0,3,0" />
                            <Button Content="Remove" Style="{StaticResource DangerButton}"
                                    Command="{Binding DeleteCommand}" Margin="6,0,0,0" />
                        </UniformGrid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>