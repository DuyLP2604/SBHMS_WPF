<UserControl x:Class="SHBMS.View.ServiceRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FB"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Cuộn toàn bộ giao diện FE-08 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="16,12,16,12"
              MinWidth="700">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Tiêu đề chức năng FE-08 -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,12">

                <TextBlock Text="HOTEL OPERATIONS"
                           Foreground="#4169E1"
                           FontWeight="Bold"
                           FontSize="10"/>

                <TextBlock Text="Service requests"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#13233C"
                           Margin="0,2,0,2"/>

                <TextBlock
                    Text="Manage guest service requests and complaints."
                    FontSize="12"
                    Foreground="#718096"/>
            </StackPanel>

            <!-- Khu vực tìm kiếm và lọc yêu cầu -->
            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="12"
                    Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock Text="Search and filter"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,10"/>

                    <WrapPanel Orientation="Horizontal">

                        <TextBox x:Name="SearchBox"
                                 Width="180"
                                 Height="38"
                                 ToolTip="Search requests"
                                 Margin="0,0,8,6"/>

                        <Button Content="Search"
                                Style="{StaticResource PrimaryButton}"
                                Click="Search_Click"
                                Margin="0,0,8,6"/>

                        <!-- Lọc theo trạng thái -->
                        <ComboBox x:Name="StatusFilterBox"
                                  Width="150"
                                  Height="38"
                                  SelectedIndex="0"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="FilterChanged"
                                  Margin="0,0,8,6">

                            <ComboBoxItem Content="All Status"/>
                            <ComboBoxItem Content="Pending"/>
                            <ComboBoxItem Content="InProgress"/>
                            <ComboBoxItem Content="Resolved"/>
                            <ComboBoxItem Content="Rejected"/>
                        </ComboBox>

                        <!-- Hiển thị lại toàn bộ yêu cầu -->
                        <Button Content="Show All"
                                Style="{StaticResource SecondaryButton}"
                                Click="ShowAll_Click"
                                Margin="0,0,0,6"/>

                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Danh sách yêu cầu dịch vụ và khiếu nại -->
            <Border Grid.Row="2"
                    Style="{StaticResource Card}"
                    Padding="12"
                    Margin="0,0,0,12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Service request list"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,10"/>

                    <!-- Hai tab phân loại yêu cầu -->
                    <TabControl x:Name="RequestTabs"
                                Grid.Row="1"
                                Height="38"
                                SelectedIndex="0"
                                Margin="0,0,0,10"
                                SelectionChanged="RequestTabs_SelectionChanged">

                        <TabItem Header="Service Requests"
                                 Width="160"/>

                        <TabItem Header="Complaints"
                                 Width="140"/>
                    </TabControl>

                    <!-- Bảng hiển thị yêu cầu theo tab -->
                    <DataGrid x:Name="RequestsGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserReorderColumns="False"
                              SelectionMode="Single"
                              RowHeight="36"
                              ColumnHeaderHeight="38"
                              SelectionChanged="RequestChanged"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="ID"
                                Binding="{Binding RequestId}"
                                Width="55"/>

                            <DataGridTextColumn
                                Header="ROOM"
                                Binding="{Binding RoomNumber}"
                                Width="75"/>

                            <DataGridTextColumn
                                Header="TYPE"
                                Binding="{Binding RequestType}"
                                Width="140"/>

                            <DataGridTextColumn
                                Header="DETAILS"
                                Binding="{Binding RequestDetails}"
                                Width="*"
                                MinWidth="150"/>

                            <DataGridTextColumn
                                Header="STATUS"
                                Binding="{Binding Status}"
                                Width="115"/>

                            <DataGridTextColumn
                                Header="CREATED AT"
                                Binding="{Binding CreatedAt,
                                StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                Width="145"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Tổng số yêu cầu -->
                    <Border Grid.Row="3"
                            Background="#EAF4ED"
                            CornerRadius="6"
                            Padding="8"
                            Margin="0,8,0,0">

                        <TextBlock x:Name="CountText"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#167A4B"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Thông tin chi tiết và xử lý yêu cầu -->
            <Border Grid.Row="3"
                    Style="{StaticResource Card}"
                    Padding="20"
                    Margin="0,0,0,16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thông tin chi tiết yêu cầu -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Request details"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,18"/>

                        <!-- Nhập số phòng -->
                        <TextBlock Text="ROOM NUMBER"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="RoomBox"
                                 Height="38"
                                 Margin="0,5,0,15"/>

                        <!-- Chọn loại yêu cầu -->
                        <TextBlock Text="REQUEST TYPE"
                                   Style="{StaticResource FieldLabel}"/>

                        <ComboBox x:Name="RequestTypeBox"
                                  Height="38"
                                  SelectedIndex="0"
                                  Margin="0,5,0,15">

                            <ComboBoxItem Content="Service Request"/>
                            <ComboBoxItem Content="Complaint"/>
                        </ComboBox>

                        <!-- Nhập nội dung yêu cầu -->
                        <TextBlock Text="REQUEST CONTENT"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="DetailsBox"
                                 Height="95"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="10"
                                 Margin="0,5,0,15"/>

                        <!-- Nhập ghi chú xử lý -->
                        <TextBlock Text="PROCESSING NOTES"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="NotesBox"
                                 Height="95"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="10"
                                 Margin="0,5,0,20"/>

                        <!-- Tạo và lưu yêu cầu -->
                        <WrapPanel>

                            <Button Content="New Request"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="120"
                                    Height="38"
                                    Click="New_Click"
                                    Margin="0,0,10,8"/>

                            <Button Content="Save Request"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="120"
                                    Height="38"
                                    Click="Save_Click"
                                    Margin="0,0,0,8"/>

                        </WrapPanel>
                    </StackPanel>

                    <!-- Các thao tác xử lý yêu cầu -->
                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Request actions"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,18"/>

                        <!-- Hiển thị yêu cầu đang chọn -->
                        <TextBlock Text="SELECTED REQUEST"
                                   Style="{StaticResource FieldLabel}"/>

                        <Border Background="#F5F8FD"
                                BorderBrush="#E2EAF4"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,8,0,20">

                            <TextBlock x:Name="SelectedRequestText"
                                       Text="No request selected"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="#344766"/>
                        </Border>

                        <!-- Chọn trạng thái xử lý -->
                        <TextBlock Text="UPDATE STATUS"
                                   Style="{StaticResource FieldLabel}"/>

                        <ComboBox x:Name="StatusBox"
                                  Height="38"
                                  SelectedIndex="0"
                                  Margin="0,8,0,25">

                            <ComboBoxItem Content="Pending"/>
                            <ComboBoxItem Content="InProgress"/>
                            <ComboBoxItem Content="Resolved"/>
                            <ComboBoxItem Content="Rejected"/>
                        </ComboBox>

                        <!-- Tiếp nhận, cập nhật và giải quyết yêu cầu -->
                        <WrapPanel>

                            <Button Content="Accept"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="95"
                                    Height="38"
                                    Click="Accept_Click"
                                    Margin="0,0,10,10"/>

                            <Button Content="Update"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="95"
                                    Height="38"
                                    Click="Update_Click"
                                    Margin="0,0,10,10"/>

                            <Button Content="Resolve"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="#15875A"
                                    MinWidth="95"
                                    Height="38"
                                    Click="Resolve_Click"
                                    Margin="0,0,10,10"/>

                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
