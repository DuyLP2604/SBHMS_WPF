<UserControl x:Class="SHBMS.View.ServiceRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FB" FontFamily="Segoe UI">
    <UserControl.Resources><ResourceDictionary Source="ModernStyles.xaml"/></UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl"><Style.Triggers>
            <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
        </Style.Triggers></Style>
    </UserControl.Style>
    <Grid Margin="20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Service requests" FontSize="25" FontWeight="Bold" Foreground="#13233C"/>
            <TextBlock Text="Review and process customer service orders. Place new orders on Booking services."
                       TextWrapping="Wrap" Foreground="#718096" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <Button Content="Refresh" DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/>
                <ComboBox DockPanel.Dock="Right" Width="135" ItemsSource="{Binding Filters}" SelectedItem="{Binding StatusFilter}" Margin="10,0,0,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search booking, customer, service or notes"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" SelectionMode="Single" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                            <DataGridTextColumn Header="BOOKING" Binding="{Binding BookingId}" Width="90"/>
                            <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="*" MinWidth="135"/>
                            <DataGridTextColumn Header="SERVICE" Binding="{Binding ServiceName}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="55"/>
                            <DataGridTextColumn Header="AMOUNT" Binding="{Binding TotalAmount, StringFormat=N0}" Width="105"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Process service order" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="BOOKING" Style="{StaticResource FieldLabel}" Margin="0,15,0,4"/>
                        <TextBlock Text="{Binding SelectedRequest.BookingId, TargetNullValue=Select an order from the list}" Foreground="#13233C" TextWrapping="Wrap"/>
                        <TextBlock Text="CUSTOMER" Style="{StaticResource FieldLabel}" Margin="0,15,0,4"/>
                        <TextBlock Text="{Binding SelectedRequest.CustomerName}" Foreground="#13233C" TextWrapping="Wrap"/>
                        <TextBlock Text="SERVICE" Style="{StaticResource FieldLabel}" Margin="0,15,0,4"/>
                        <TextBlock Text="{Binding SelectedRequest.ServiceName}" Foreground="#13233C" TextWrapping="Wrap"/>
                        <TextBlock Text="NOTES" Style="{StaticResource FieldLabel}" Margin="0,15,0,4"/>
                        <TextBlock Text="{Binding SelectedRequest.Details}" Foreground="#13233C" TextWrapping="Wrap"/>
                        <TextBlock Text="CREATED" Style="{StaticResource FieldLabel}" Margin="0,15,0,4"/>
                        <TextBlock Text="{Binding SelectedRequest.CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="#13233C"/>
                        <TextBlock Text="HANDLED BY" Style="{StaticResource FieldLabel}" Margin="0,15,0,4"/>
                        <TextBlock Text="{Binding SelectedRequest.HandledBy}" Foreground="#13233C"/>
                        <TextBlock Text="CURRENT STATUS" Style="{StaticResource FieldLabel}" Margin="0,15,0,4"/>
                        <TextBlock Text="{Binding SelectedRequest.Status}" Foreground="#4169E1" FontWeight="SemiBold"/>
                        <TextBlock Text="UPDATE STATUS" Style="{StaticResource FieldLabel}" Margin="0,15,0,6"/>
                        <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" MinHeight="36"/>
                        <Button Content="Update status" Command="{Binding UpdateStatusCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,15,0,0"/>
                        <TextBlock Text="Only completed orders add charges. Checkout rejects unfinished orders automatically."
                                   TextWrapping="Wrap" Foreground="#718096" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
