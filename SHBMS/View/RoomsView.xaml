<UserControl x:Class="SHBMS.View.RoomsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><ResourceDictionary Source="OperationsStyles.xaml"/></UserControl.Resources>
    <Grid Margin="24,14,24,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="Rooms" FontSize="26" FontWeight="SemiBold" Foreground="#13233C"/><TextBlock Text="View room information and operating status" Style="{StaticResource SmallMuted}" Margin="0,5,0,20"/></StackPanel><Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}"/></Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search room number or room type" Margin="0,0,12,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}"/></Grid>
        <StackPanel Grid.Row="2"><TextBlock Style="{StaticResource OperationMessage}"/><ProgressBar Style="{StaticResource BusyIndicator}"/><TextBlock Text="Room status is its operating condition. Booking availability also depends on stay dates." Style="{StaticResource SmallMuted}" Margin="0,0,0,9"/><TextBlock Text="{Binding RoomCount, StringFormat={}{0} rooms shown}" Style="{StaticResource SmallMuted}" Margin="0,0,0,10"/></StackPanel>
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="6"><DataGrid ItemsSource="{Binding Rooms}"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding RoomId}" Width="65"/><DataGridTextColumn Header="Room" Binding="{Binding RoomNumber}" Width="90"/><DataGridTextColumn Header="Room type" Binding="{Binding RoomTypeName}" Width="180"/><DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" Width="80"/><DataGridTextColumn Header="Price / night" Binding="{Binding BasePrice, StringFormat=N0}" Width="130"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="135"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="160"/></DataGrid.Columns></DataGrid></Border>
    </Grid>
</UserControl>
