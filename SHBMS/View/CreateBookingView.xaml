<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SHBMS.View.CreateBookingView" Background="{DynamicResource Bg}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid Margin="20,14" Visibility="{Binding CanCreate, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="New booking" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Navy}"/>
            <TextBlock Text="Choose the customer, dates and room types, then confirm the room charge." Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1. Customer" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="CUSTOMER PHONE" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding PhoneSearch, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" Width="190"/>
                            </StackPanel>
                            <WrapPanel VerticalAlignment="Bottom" Margin="0,0,0,8">
                                <Button Content="Find customer" Command="{Binding SearchCustomersCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="14,8"/>
                                <Button Content="New customer" Command="{Binding NewCustomerCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,8"/>
                            </WrapPanel>
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding CustomerMatches}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" Height="110" CanUserDeleteRows="False" CanUserReorderColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CUSTOMER ID" Binding="{Binding CustomerId}" Width="100" MinWidth="95"/>
                                <DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}" Width="*" MinWidth="85"/>
                                <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="130" MinWidth="110"/>
                                <DataGridTextColumn Header="IDENTITY" Binding="{Binding IdentityNumber}" Width="150" MinWidth="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding CustomerModeText}" Foreground="{StaticResource Accent}" Margin="0,10,0,10"/>
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="FULL NAME *" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsCustomerReadOnly}" MaxLength="100"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="PHONE *" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsCustomerReadOnly}" MaxLength="15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="IDENTITY NUMBER" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding IdentityNumber, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsCustomerReadOnly}" MaxLength="20"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsCustomerReadOnly}" MaxLength="100"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="ADDRESS" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsCustomerReadOnly}" MaxLength="200"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="NATIONALITY" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NationalityName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsCustomerReadOnly}" MaxLength="50"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="2. Dates and available rooms" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="CHECK-IN" Style="{StaticResource FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding CheckInDate, Mode=TwoWay}" DisplayDateStart="{Binding Today}" Width="170" Height="36"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="CHECK-OUT" Style="{StaticResource FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding CheckOutDate, Mode=TwoWay}" DisplayDateStart="{Binding Today}" Width="170" Height="36"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,8">
                                <Button Content="Search available rooms" Command="{Binding SearchRoomsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="14,8"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="Changing dates or searching again clears selected rooms." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
                        <DataGrid ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedAvailableType, Mode=TwoWay}" Height="155" CanUserDeleteRows="False" CanUserReorderColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ROOM TYPE" Binding="{Binding Name}" Width="*" MinWidth="85"/>
                                <DataGridTextColumn Header="CAPACITY" Binding="{Binding Capacity}" Width="90" MinWidth="85"/>
                                <DataGridTextColumn Header="PRICE / NIGHT (VND)" Binding="{Binding UnitPrice, StringFormat=N2}" Width="170" MinWidth="155"/>
                                <DataGridTextColumn Header="AVAILABLE" Binding="{Binding AvailableRooms}" Width="100" MinWidth="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,10,0,0">
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="QUANTITY" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Width="95" MaxLength="9"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,8">
                                <Button Content="Add to booking" Command="{Binding AddRoomCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="14,8"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="3. Selected rooms" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedCartItem, Mode=TwoWay}" Height="140" CanUserDeleteRows="False" CanUserReorderColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ROOM TYPE" Binding="{Binding TypeName}" Width="*" MinWidth="85"/>
                                <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="70" MinWidth="60"/>
                                <DataGridTextColumn Header="NIGHTS" Binding="{Binding NumberOfNights}" Width="80" MinWidth="65"/>
                                <DataGridTextColumn Header="PRICE / NIGHT" Binding="{Binding UnitPrice, StringFormat=N2}" Width="145" MinWidth="125"/>
                                <DataGridTextColumn Header="LINE TOTAL" Binding="{Binding LineTotal, StringFormat=N2}" Width="145" MinWidth="125"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Remove selected" Command="{Binding RemoveRoomCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Padding="14,8"/>
                            <TextBlock Text="To change quantity, remove its row and add it again." Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,8,0,0">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="Back" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,8"/>
                    <Button Content="Confirm booking" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="14,8"/>
                </WrapPanel>
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="ROOMS: " Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding TotalRooms}" FontWeight="SemiBold"/>
                        <TextBlock Text="   NIGHTS: " Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding NumberOfNights}" FontWeight="SemiBold"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding TotalAmount, StringFormat=N2}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="Room charge (VND). Payment is recorded separately." Foreground="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
