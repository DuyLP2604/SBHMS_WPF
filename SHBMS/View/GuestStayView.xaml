<UserControl x:Class="SHBMS.View.GuestStayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FB" FontFamily="Segoe UI">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Guest stays" FontSize="25" FontWeight="Bold" Foreground="#13233C" />
            <TextBlock Text="All stays, rooms and charges are read from the database. Check-in and check-out have their own menus." TextWrapping="Wrap" Foreground="#718096" Margin="0,5,0,0" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="SEARCH" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="235" ToolTip="Booking, customer, phone or room" />
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="SHOW" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding FilterOption, Mode=TwoWay}" Width="160" Height="39" Padding="8,0" VerticalContentAlignment="Center" />
            </StackPanel>
            <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" VerticalAlignment="Bottom" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" VerticalAlignment="Bottom" />
        </WrapPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Summary}" Foreground="#718096" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding StaysView}" SelectedItem="{Binding SelectedStay, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserReorderColumns="False" CanUserAddRows="False"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="BOOKING" Binding="{Binding BookingId}" Width="85" MinWidth="75" />
                            <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="*" MinWidth="110" />
                            <DataGridTextColumn Header="ROOMS" Binding="{Binding RoomNumbers}" Width="90" MinWidth="70" />
                            <DataGridTextColumn Header="ARRIVAL" Binding="{Binding CheckInDate, StringFormat={}{0:dd/MM/yyyy}}" Width="95" MinWidth="85" />
                            <DataGridTextColumn Header="DEPARTURE" Binding="{Binding CheckOutDate, StringFormat={}{0:dd/MM/yyyy}}" Width="95" MinWidth="85" />
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Phase}" Width="130" MinWidth="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Select a stay in the list to see its details." Foreground="#718096" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="BOOKING" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedStay.BookingId}" Foreground="#13233C" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="CUSTOMER" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                                <TextBlock Text="{Binding SelectedStay.CustomerName}" TextWrapping="Wrap" Foreground="#13233C" FontSize="14" />
                                <TextBlock Text="{Binding SelectedStay.CustomerPhone}" Foreground="#718096" />
                                <TextBlock Text="STAY" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                                <TextBlock Foreground="#13233C" FontSize="14" TextWrapping="Wrap">
                                    <Run Text="{Binding SelectedStay.CheckInDate, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy}}" />
                                    <Run Text=" - " />
                                    <Run Text="{Binding SelectedStay.CheckOutDate, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy}}" />
                                    <Run Text=" | " />
                                    <Run Text="{Binding SelectedStay.Nights, Mode=OneWay, StringFormat={}{0} night(s)}" />
                                </TextBlock>
                                <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                                <TextBlock Text="{Binding SelectedStay.Phase}" Foreground="#13233C" FontSize="14" />
                                <TextBlock Text="{Binding SelectedStay.CheckInDeadline, StringFormat=Check-in deadline: {0:dd/MM/yyyy HH:mm}}" Foreground="#718096" FontSize="12" />
                                <TextBlock Text="Rooms" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                                <ItemsControl ItemsSource="{Binding SelectedStay.Rooms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Services" Style="{StaticResource SectionTitle}" Margin="0,12,0,8" />
                                <ItemsControl ItemsSource="{Binding SelectedStay.Services}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Charges" Style="{StaticResource SectionTitle}" Margin="0,12,0,8" />
                                <TextBlock Text="{Binding SelectedStay.RoomCharge, StringFormat=Room charge: {0:N0}}" />
                                <TextBlock Text="{Binding SelectedStay.ServiceCharge, StringFormat=Service charge: {0:N0}}" />
                                <TextBlock Text="{Binding SelectedStay.TotalCharge, StringFormat=Total: {0:N0}}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedStay.PaidAmount, StringFormat=Paid: {0:N0}}" />
                                <TextBlock Text="{Binding SelectedStay.Balance, StringFormat=Balance: {0:N0}}" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
