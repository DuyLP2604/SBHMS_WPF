<UserControl x:Class="SHBMS.View.GuestStayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FB" FontFamily="Segoe UI">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

<UserControl.Resources><ResourceDictionary Source="ModernStyles.xaml" /></UserControl.Resources>
<Grid Margin="20,16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,12">
<TextBlock Text="Guest stays" FontSize="25" FontWeight="Bold" Foreground="#13233C" />
<TextBlock Text="Database booking overview. Check-in, checkout and walk-in creation are currently unavailable." TextWrapping="Wrap" Foreground="#718096" Margin="0,5,0,0" />
<TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#B45309" Margin="0,6,0,0" />
</StackPanel>
<WrapPanel Grid.Row="1" Margin="0,0,0,12"><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="235" Margin="0,0,8,0" ToolTip="Search" /><Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" /><Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" /></WrapPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*" MinWidth="235"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Padding="12"><DataGrid ItemsSource="{Binding BookingsView}" SelectedItem="{Binding SelectedBooking}" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
<DataGrid.Columns><DataGridTextColumn Header="BOOKING" Binding="{Binding BookingId}" Width="95" MinWidth="85" /><DataGridTextColumn Header="CUSTOMER" Binding="{Binding Customer.FullName}" Width="*" MinWidth="85" /><DataGridTextColumn Header="ARRIVAL" Binding="{Binding CheckInDate}" Width="110" MinWidth="85" /><DataGridTextColumn Header="DEPARTURE" Binding="{Binding CheckOutDate}" Width="110" MinWidth="85" /><DataGridTextColumn Header="STATUS" Binding="{Binding BookingStatus}" Width="120" MinWidth="85" /></DataGrid.Columns></DataGrid></Border>
<Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#4169E1" /><TextBlock Text="BOOKING" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" /><TextBlock Text="{Binding SelectedBooking.BookingId}" TextWrapping="Wrap" Foreground="#13233C" FontSize="14" /><TextBlock Text="CUSTOMER" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" /><TextBlock Text="{Binding SelectedBooking.Customer.FullName}" TextWrapping="Wrap" Foreground="#13233C" FontSize="14" /><TextBlock Text="STATUS" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" /><TextBlock Text="{Binding SelectedBooking.BookingStatus}" TextWrapping="Wrap" Foreground="#13233C" FontSize="14" /><TextBlock Text="ASSIGNED ROOMS" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" /><TextBlock Text="{Binding RoomText}" TextWrapping="Wrap" Foreground="#13233C" FontSize="14" /><TextBlock Text="TOTAL CHARGE" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" /><TextBlock Text="{Binding TotalCharge}" TextWrapping="Wrap" Foreground="#13233C" FontSize="14" /><TextBlock Text="Booking details" Style="{StaticResource SectionTitle}" Margin="0,18,0,10" /><ItemsControl ItemsSource="{Binding SelectedBooking.BookingDetails}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,10"><TextBlock Text="{Binding RoomTypeId}" FontWeight="SemiBold" /><TextBlock Text="{Binding Quantity, StringFormat=Quantity: {0}}" /><TextBlock Text="{Binding UnitPrice, StringFormat=Unit price: {0:N2}}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Border></Grid>
</Grid></UserControl>
