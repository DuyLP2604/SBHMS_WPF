<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SHBMS.View.BookingsView" Background="{DynamicResource Bg}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid Margin="20,14" Visibility="{Binding CanView, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.2*" MinHeight="150"/>
            <RowDefinition Height="1*" MinHeight="190"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right">
                <Button Content="New booking" Command="{Binding NewBookingCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="14,8" Visibility="{Binding CanCreate, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Bookings" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Navy}"/>
                <TextBlock Text="{Binding AccessHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="SEARCH" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="170" ToolTip="Booking ID, customer name or phone"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding FilterStatus, Mode=TwoWay}" Width="145" Height="39" Padding="8,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="CREATED BY" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Employees}" DisplayMemberPath="Name" SelectedValuePath="EmployeeId" SelectedValue="{Binding FilterEmployeeId, Mode=TwoWay}" Width="190" Height="39" Padding="8,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="CHECK-IN FROM" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="145" Height="32"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="CHECK-IN TO" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="145" Height="32"/>
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Bottom" Margin="4,0,0,8">
                        <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="14,8"/>
                        <Button Content="Reset" Command="{Binding ResetFiltersCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,8"/>
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,8"/>
                    </WrapPanel>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding BookingsView}" SelectedItem="{Binding SelectedBooking, Mode=TwoWay}" CanUserDeleteRows="False" CanUserReorderColumns="False" Grid.Row="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="BOOKING" Binding="{Binding BookingId}" Width="90" MinWidth="80"/>
                        <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="CHECK-IN" Binding="{Binding CheckInDate, StringFormat=dd/MM/yyyy}" Width="105" MinWidth="100"/>
                        <DataGridTextColumn Header="CHECK-OUT" Binding="{Binding CheckOutDate, StringFormat=dd/MM/yyyy}" Width="105" MinWidth="100"/>
                        <DataGridTextColumn Header="ROOMS" Binding="{Binding TotalRooms}" Width="75" MinWidth="65"/>
                        <DataGridTextColumn Header="TOTAL (VND)" Binding="{Binding TotalAmount, StringFormat=N2}" Width="130" MinWidth="115"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="125" MinWidth="115"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Booking details" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="BOOKING" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding SelectedBooking.BookingId}" Foreground="{StaticResource Navy}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="CUSTOMER" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding SelectedBooking.CustomerName}" Foreground="{StaticResource Navy}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="PHONE" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding SelectedBooking.CustomerPhone}" Foreground="{StaticResource Navy}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="CREATED BY" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding SelectedBooking.CreatedByEmployeeName}" Foreground="{StaticResource Navy}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="CREATED AT" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding SelectedBooking.BookingDate}" Foreground="{StaticResource Navy}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="CHECK-IN DEADLINE" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding SelectedBooking.CheckInDeadline}" Foreground="{StaticResource Navy}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="ROOM CHARGE" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding SelectedBooking.RoomSubtotal, StringFormat=N2}" Foreground="{StaticResource Navy}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="SERVICE CHARGE" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding SelectedBooking.ServiceSubtotal, StringFormat=N2}" Foreground="{StaticResource Navy}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="PAID / REMAINING" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding SelectedBooking.PaidAmount, StringFormat=N2}" Foreground="{StaticResource Navy}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedBooking.RemainingAmount, StringFormat=N2}" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid ItemsSource="{Binding SelectedBooking.Rooms}" Height="130" CanUserDeleteRows="False" CanUserReorderColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ROOM TYPE" Binding="{Binding TypeName}" Width="*" MinWidth="120"/>
                            <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="65" MinWidth="60"/>
                            <DataGridTextColumn Header="NIGHTS" Binding="{Binding NumberOfNights}" Width="75" MinWidth="65"/>
                            <DataGridTextColumn Header="PRICE / NIGHT" Binding="{Binding UnitPrice, StringFormat=N2}" Width="125" MinWidth="110"/>
                            <DataGridTextColumn Header="LINE TOTAL" Binding="{Binding LineTotal, StringFormat=N2}" Width="125" MinWidth="110"/>
                            <DataGridTextColumn Header="ASSIGNED ROOMS" Binding="{Binding AssignedRooms}" Width="*" MinWidth="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Expander Header="Services and payments" Margin="0,8,0,0">
                        <StackPanel>
                            <DataGrid ItemsSource="{Binding SelectedBooking.Services}" Height="90" CanUserDeleteRows="False" CanUserReorderColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SERVICE" Binding="{Binding ServiceName}" Width="*" MinWidth="85"/>
                                    <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="70" MinWidth="60"/>
                                    <DataGridTextColumn Header="UNIT PRICE" Binding="{Binding UnitPrice, StringFormat=N2}" Width="120" MinWidth="100"/>
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount, StringFormat=N2}" Width="120" MinWidth="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid ItemsSource="{Binding SelectedBooking.Payments}" Height="90" CanUserDeleteRows="False" CanUserReorderColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PAYMENT TIME" Binding="{Binding PaymentTime}" Width="*" MinWidth="85"/>
                                    <DataGridTextColumn Header="METHOD" Binding="{Binding MethodName}" Width="*" MinWidth="85"/>
                                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=N2}" Width="140" MinWidth="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{Binding SelectedBooking.CancellationReason}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
