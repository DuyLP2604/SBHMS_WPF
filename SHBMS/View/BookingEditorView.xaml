<UserControl x:Class="SHBMS.View.BookingEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><ResourceDictionary Source="OperationsStyles.xaml"/></UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="New customer booking" FontSize="26" FontWeight="SemiBold" Foreground="#13233C"/><TextBlock Text="Choose a customer, dates and available room types" Style="{StaticResource SmallMuted}" Margin="0,5,0,18"/></StackPanel><Button Content="Back to bookings" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" HorizontalAlignment="Right"/></Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                    <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource NotBusy}}">
                        <TextBlock Text="Guest and stay" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                        <TextBlock Text="Customer" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="DisplayName" IsTextSearchEnabled="True" Margin="0,0,0,15"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Check-in" Style="{StaticResource FieldLabel}"/><DatePicker SelectedDate="{Binding CheckInDate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Check-out" Style="{StaticResource FieldLabel}"/><DatePicker SelectedDate="{Binding CheckOutDate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Arrival deadline" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding CheckInDeadline, StringFormat=dd/MM/yyyy HH:mm}" Foreground="#355780" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid><TextBlock Text="Rooms" Style="{StaticResource SectionTitle}"/><Button Content="Check availability" Command="{Binding CheckAvailabilityCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"/></Grid>
                        <TextBlock Text="Sample room types are shown to preview the booking form." Style="{StaticResource SmallMuted}" Margin="0,9,0,15"/>
                        <Grid IsEnabled="{Binding IsBusy, Converter={StaticResource NotBusy}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Available room type" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedRoomType}" DisplayMemberPath="DisplayName"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Quantity" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <Button Grid.Column="2" Content="Add rooms" Command="{Binding AddRoomsCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
                        </Grid>
                        <DataGrid ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedCartLine}" Height="180" Margin="0,16,0,8">
                            <DataGrid.Columns><DataGridTextColumn Header="Room type" Binding="{Binding RoomTypeName}" Width="*"/><DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" Width="80"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="65"/><DataGridTextColumn Header="Nights" Binding="{Binding NumberOfNights}" Width="65"/><DataGridTextColumn Header="Price / night" Binding="{Binding UnitPrice, StringFormat=N0}" Width="120"/><DataGridTextColumn Header="Line total" Binding="{Binding LineTotal, StringFormat=N0}" Width="130"/></DataGrid.Columns>
                        </DataGrid>
                        <Button Content="Remove selected type" Command="{Binding RemoveRoomsCommand}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Padding="12,7"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2"><TextBlock Style="{StaticResource OperationMessage}"/><ProgressBar Style="{StaticResource BusyIndicator}"/>
            <Border Background="White" CornerRadius="12" Padding="18" Margin="0,7,0,0"><Grid><StackPanel><TextBlock Text="Estimated room total" Style="{StaticResource SmallMuted}"/><TextBlock Text="{Binding EstimatedTotal, StringFormat={}{0:N0} VND}" FontSize="23" FontWeight="SemiBold" Foreground="#13233C"/><TextBlock Text="{Binding TotalRooms, StringFormat={}{0} rooms}" Style="{StaticResource SmallMuted}"/></StackPanel><Button Content="Create booking" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
        </StackPanel>
    </Grid>
</UserControl>
