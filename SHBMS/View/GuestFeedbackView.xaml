<UserControl x:Class="SHBMS.View.GuestFeedbackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FB"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />

            <!-- Overview -->
            <RowDefinition Height="Auto" />

            <!-- Feedback list -->
            <RowDefinition Height="1.2*"
                           MinHeight="145" />

            <!-- Splitter -->
            <RowDefinition Height="8" />

            <!-- Feedback details -->
            <RowDefinition Height="1*"
                           MinHeight="170" />
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,10">

            <TextBlock Text="GUEST EXPERIENCE"
                       Foreground="#4169E1"
                       FontWeight="Bold"
                       FontSize="10" />

            <TextBlock Text="Guest feedback"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#13233C"
                       Margin="0,2,0,2" />

            <TextBlock Text="Track and resolve guest concerns."
                       FontSize="12"
                       Foreground="#718096" />
        </StackPanel>

        <!-- OVERVIEW -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="12"
                Margin="0,0,0,10">

            <DockPanel LastChildFill="True">

                <Border DockPanel.Dock="Right"
                        Background="#EAF4ED"
                        Padding="10,7"
                        CornerRadius="8"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">

                    <TextBlock x:Name="CountText"
                               Foreground="#167A4B"
                               FontWeight="SemiBold"
                               FontSize="12" />
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Feedback overview"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#13233C" />

                    <TextBlock Text="Guest concerns and resolutions"
                               FontSize="11"
                               Foreground="#8793A6" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- FEEDBACK INBOX -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="12"
                Margin="0,0,0,4"
                MinHeight="0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"
                                   MinHeight="0" />
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Text="Feedback inbox"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#13233C"
                           Margin="0,0,0,8" />

                <!-- Search -->
                <WrapPanel Grid.Row="1"
                           Margin="0,0,0,8"
                           Orientation="Horizontal">

                    <TextBox x:Name="SearchBox"
                             Width="185"
                             Height="35"
                             Margin="0,0,8,4"
                             ToolTip="Search guest feedback" />

                    <Button Content="Search"
                            Style="{StaticResource PrimaryButton}"
                            Click="Search_Click"
                            Padding="12,7"
                            Margin="0,0,8,4" />

                    <Button Content="All feedback"
                            Style="{StaticResource SecondaryButton}"
                            Click="ShowAll_Click"
                            Padding="12,7"
                            Margin="0,0,0,4" />
                </WrapPanel>

                <!-- Feedback Table -->

                <DataGrid x:Name="FeedbackGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDF1F7"
                          SelectionChanged="FeedbackGrid_SelectionChanged">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding ComplaintID}"
                                            Width="60"
                                            MinWidth="60" />

                        <DataGridTextColumn Header="CUSTOMER"
                                            Binding="{Binding GuestName}"
                                            Width="155"
                                            MinWidth="155" />

                        <DataGridTextColumn Header="FEEDBACK"
                                            Binding="{Binding Content}"
                                            Width="240"
                                            MinWidth="200" />

                        <DataGridTextColumn Header="STATUS"
                                            Binding="{Binding Status}"
                                            Width="120"
                                            MinWidth="120" />

                        <DataGridTextColumn Header="REPLY"
                                            Binding="{Binding ReplyMessage}"
                                            Width="*"
                                            MinWidth="190" />

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- RESIZE HANDLE -->
        <GridSplitter Grid.Row="3"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      Cursor="SizeNS"
                      Background="#DCE5F1"
                      Margin="12,0" />

        <!-- FEEDBACK DETAILS -->
        <Border Grid.Row="4"
                Style="{StaticResource Card}"
                Padding="12"
                MinHeight="0">

            <!-- Scroll only the details area -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">

                <StackPanel>

                    <!-- Header -->
                    <TextBlock Text="Feedback details"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#13233C"
                               Margin="0,0,0,10" />

                    <!-- Customer Information -->
                    <WrapPanel Margin="0,0,0,10"
                               Orientation="Horizontal">

                        <StackPanel Width="145"
                                    Margin="0,0,10,7">

                            <TextBlock Text="CUSTOMER ID"
                                       Style="{StaticResource FieldLabel}" />

                            <TextBlock x:Name="DetailCustomerId"
                                       Text="--"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#13233C" />
                        </StackPanel>

                        <StackPanel Width="200"
                                    Margin="0,0,10,7">

                            <TextBlock Text="GUEST NAME"
                                       Style="{StaticResource FieldLabel}" />

                            <TextBlock x:Name="DetailGuestName"
                                       Text="--"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#13233C" />
                        </StackPanel>

                        <StackPanel Width="140"
                                    Margin="0,0,0,7">

                            <TextBlock Text="STATUS"
                                       Style="{StaticResource FieldLabel}" />

                            <TextBlock x:Name="DetailStatus"
                                       Text="--"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#4169E1" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- Full Feedback -->
                    <TextBlock Text="FULL FEEDBACK CONTENT"
                               Style="{StaticResource FieldLabel}" />

                    <Border Background="#F5F8FD"
                            BorderBrush="#E2EAF4"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,12">

                        <ScrollViewer MaxHeight="100"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <TextBlock x:Name="DetailFeedbackContent"
                                       Text="Select a feedback to view its content."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       LineHeight="20"
                                       Foreground="#344766" />
                        </ScrollViewer>
                    </Border>

                    <!-- Reply -->
                    <TextBlock Text="REPLY / RESOLUTION NOTE"
                               Style="{StaticResource FieldLabel}" />

                    <TextBox x:Name="ReplyBox"
                             Height="75"
                             Padding="10"
                             Margin="0,0,0,10"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" />

                    <!-- Action Buttons -->
                    <WrapPanel HorizontalAlignment="Right"
                               Orientation="Horizontal">

                        <Button Content="Mark as pending"
                                Style="{StaticResource SecondaryButton}"
                                Click="Pending_Click"
                                Padding="12,7"
                                Margin="0,0,8,5" />

                        <Button Content="✓ Resolve feedback"
                                Style="{StaticResource PrimaryButton}"
                                Background="#15875A"
                                Click="Resolve_Click"
                                Padding="12,7"
                                Margin="0,0,0,5" />
                    </WrapPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
