<UserControl x:Class="SHBMS.View.RevenueManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg}"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16,10">
        <Grid.RowDefinitions>
            <!-- Header & Switcher tabs -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Revenue Reports -->
            <RowDefinition Height="*"/>
            <!-- 2 & 3. Promotions + Pricing -->
            <RowDefinition Height="1.2*"/>
        </Grid.RowDefinitions>

        <!-- HEADER + DUAL FUNCTION NAVIGATION TABS -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="REVENUE &amp; PRICING MANAGEMENT" 
                       FontSize="18" FontWeight="Bold" Foreground="{StaticResource Navy}" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="📋 View All" Command="{Binding SwitchTabCommand}" CommandParameter="0" 
                        Style="{StaticResource SecondaryButton}" Margin="3,0" Padding="12,6"/>
                <Button Content="📊 1. Revenue Reports" Command="{Binding SwitchTabCommand}" CommandParameter="1" 
                        Style="{StaticResource PrimaryButton}" Margin="3,0" Padding="12,6"/>
                <Button Content="🏷️ 2. Promotions &amp; Pricing" Command="{Binding SwitchTabCommand}" CommandParameter="2" 
                        Style="{StaticResource SecondaryButton}" Margin="3,0" Padding="12,6"/>
            </StackPanel>
        </Grid>

        <!-- 1. REVENUE REPORTS (LOADED DIRECTLY FROM INVOICE TABLE) -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"
                Visibility="{Binding IsRevenueVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="1. Revenue Reports" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="Report type:" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding SelectedReportType}" Width="120" Height="28" Margin="5,0,15,0"/>

                    <Label Content="Select date:" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding ReportDate, Mode=TwoWay}" Width="130" Height="28" Margin="5,0,15,0"/>

                    <Button Content="View Report" Command="{Binding ViewReportCommand}" Style="{StaticResource PrimaryButton}" Padding="14,4" Height="28" Margin="0,0,8,0"/>
                    <Button Content="All" Command="{Binding ResetReportCommand}" Style="{StaticResource SecondaryButton}" Padding="14,4" Height="28"/>
                </StackPanel>

                <!-- Revenue DataGrid -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding RevenueList}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Period / Date" Binding="{Binding Period}" Width="130"/>
                        <DataGridTextColumn Header="Room Revenue" Binding="{Binding RoomRevenue, StringFormat='{}{0:N0} VND'}" Width="150"/>
                        <DataGridTextColumn Header="Service Revenue" Binding="{Binding ServiceRevenue, StringFormat='{}{0:N0} VND'}" Width="140"/>
                        <DataGridTextColumn Header="Total Revenue" Binding="{Binding TotalRevenue, StringFormat='{}{0:N0} VND'}" Width="150"/>
                        <DataGridTextColumn Header="Check-Ins" Binding="{Binding TotalCheckIns}" Width="90"/>
                        <DataGridTextColumn Header="Check-Outs" Binding="{Binding TotalCheckOuts}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 2 & 3. PROMOTIONS & ROOM PRICING SECTION -->
        <Grid Grid.Row="2" Visibility="{Binding IsPricingVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <!-- 2. PROMOTIONS MANAGEMENT -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="2. Promotions Management" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                    <!-- Promotion Input Form -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Promo Code:"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PromoCode, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="2"/>

                        <Label Grid.Row="0" Grid.Column="2" Content="Discount (%):"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding PromoDiscount, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="2"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Valid From:"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding PromoStartDate}" Height="28" Margin="2"/>

                        <Label Grid.Row="1" Grid.Column="2" Content="Valid To:"/>
                        <DatePicker Grid.Row="1" Grid.Column="3" SelectedDate="{Binding PromoEndDate}" Height="28" Margin="2"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Description:"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PromoDesc, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="2"/>
                        <Button Grid.Row="2" Grid.Column="3" Content="Add Promo" Command="{Binding AddPromoCommand}" Style="{StaticResource PrimaryButton}" Height="28" Margin="2"/>
                    </Grid>

                    <!-- Promotions DataGrid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding PromotionList}" SelectedItem="{Binding SelectedPromotion, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Promo Code" Binding="{Binding Code}" Width="100"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Discount (%)" Binding="{Binding DiscountPercentage, StringFormat={}{0}%}" Width="85"/>
                            <DataGridTextColumn Header="Valid From" Binding="{Binding StartDate, StringFormat='dd/MM/yyyy'}" Width="100"/>
                            <DataGridTextColumn Header="Valid To" Binding="{Binding EndDate, StringFormat='dd/MM/yyyy'}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 3. ROOM PRICING & SURCHARGES (ROOM_TYPE TABLE) -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="3. Room Pricing &amp; Surcharges" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Label Content="Weekend surcharge:" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding WeekendRate, UpdateSourceTrigger=PropertyChanged}" Width="55" Height="26" Margin="5,0,8,0"/>
                        <Button Content="Save Surcharge" Command="{Binding SavePricingRuleCommand}" Style="{StaticResource PrimaryButton}" Height="28" Padding="12,4"/>
                    </StackPanel>

                    <!-- Room Types DataGrid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding RoomTypeList}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding RoomTypeId}" Width="50"/>
                            <DataGridTextColumn Header="Room Type" Binding="{Binding TypeName}" Width="110"/>
                            <DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" Width="70"/>
                            <DataGridTextColumn Header="Base Price (VND)" Binding="{Binding Price, StringFormat='{}{0:N0}'}" Width="120"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
