<Page x:Class="SHBMS.View.RevenueManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quản lý Doanh thu &amp; Bảng giá">

    <Grid Margin="10" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1.2*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="QUẢN LÝ DOANH THU &amp; BẢNG GIÁ" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <GroupBox Grid.Row="1" Header="1. Báo Cáo Doanh Thu" Margin="0,0,0,10" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="Loại báo cáo:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cboReportType" Width="120" Height="26" SelectedIndex="0" Margin="5,0,15,0">
                        <ComboBoxItem Content="Theo Ngày"/>
                        <ComboBoxItem Content="Theo Tháng"/>
                    </ComboBox>

                    <Label Content="Chọn ngày:" VerticalAlignment="Center"/>
                    <DatePicker x:Name="dpReportDate" Width="130" Height="26" Margin="5,0,15,0"/>

                    <Button x:Name="btnViewReport" Content="Xem Báo Cáo" Width="100" Height="26"/>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="dgRevenue" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ngày" Binding="{Binding ReportDate, StringFormat='dd/MM/yyyy'}" Width="120"/>
                        <DataGridTextColumn Header="Doanh Thu Phòng" Binding="{Binding RoomRevenue}" Width="150"/>
                        <DataGridTextColumn Header="Doanh Thu Dịch Vụ" Binding="{Binding ServiceRevenue}" Width="150"/>
                        <DataGridTextColumn Header="Tổng Doanh Thu" Binding="{Binding TotalRevenue}" Width="150"/>
                        <DataGridTextColumn Header="Check-Ins" Binding="{Binding TotalCheckIns}" Width="90"/>
                        <DataGridTextColumn Header="Check-Outs" Binding="{Binding TotalCheckOuts}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="2. Quản Lý Khuyến Mãi (Promotions)" Margin="0,0,8,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Mã Code:"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtPromoCode" Height="25" Margin="2"/>

                        <Label Grid.Row="0" Grid.Column="2" Content="Giảm (%):"/>
                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtPromoDiscount" Height="25" Margin="2"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Bắt đầu:"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dpPromoStart" Height="25" Margin="2"/>

                        <Label Grid.Row="1" Grid.Column="2" Content="Kết thúc:"/>
                        <DatePicker Grid.Row="1" Grid.Column="3" x:Name="dpPromoEnd" Height="25" Margin="2"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Mô tả:"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="txtPromoDesc" Height="25" Margin="2"/>
                        <Button Grid.Row="2" Grid.Column="3" x:Name="btnAddPromo" Content="Thêm Mã" Height="25" Margin="2"/>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="dgPromotions" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Code" Binding="{Binding Code}" Width="90"/>
                            <DataGridTextColumn Header="Mô Tả" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Giảm (%)" Binding="{Binding DiscountPercentage}" Width="70"/>
                            <DataGridTextColumn Header="Bắt Đầu" Binding="{Binding StartDate, StringFormat='dd/MM/yyyy'}" Width="95"/>
                            <DataGridTextColumn Header="Kết Thúc" Binding="{Binding EndDate, StringFormat='dd/MM/yyyy'}" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="3. Cấu Hình Giá Phòng &amp; Phụ Thu" Margin="8,0,0,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Label Content="Phụ thu cuối tuần:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtWeekendRate" Text="1.2" Width="55" Height="25" Margin="5,0,10,0"/>
                        <Button x:Name="btnSavePricingRule" Content="Lưu Hệ Số" Width="80" Height="25"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="dgRoomTypes" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding RoomTypeId}" Width="45"/>
                            <DataGridTextColumn Header="Loại Phòng" Binding="{Binding Name}" Width="120"/>
                            <DataGridTextColumn Header="Sức Chứa" Binding="{Binding Capacity}" Width="70"/>
                            <DataGridTextColumn Header="Giá Gốc (VNĐ)" Binding="{Binding BasePrice}" Width="110"/>
                            <DataGridTextColumn Header="Mô Tả" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Page>