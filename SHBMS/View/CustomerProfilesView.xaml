<UserControl x:Class="SHBMS.View.CustomerProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FB"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <!-- Page title -->
            <RowDefinition Height="Auto" />

            <!-- Customer form -->
            <RowDefinition Height="Auto" />

            <!-- Customer table -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,14">

            <TextBlock Text="GUEST RELATIONS"
                       Foreground="#4169E1"
                       FontSize="10"
                       FontWeight="Bold" />

            <TextBlock Text="Customer profiles"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#13233C"
                       Margin="0,2,0,2" />

            <TextBlock Text="Manage customer information and guest records."
                       FontSize="12"
                       Foreground="#718096" />
        </StackPanel>

        <!-- CUSTOMER FORM -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="16"
                Margin="0,0,0,14">

            <StackPanel>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Customer information"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#13233C"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="* Required fields"
                               Foreground="#8793A6"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- ROW 1:
                     ID | NAME | IDENTITY | PHONE -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="2.3*" />
                        <ColumnDefinition Width="1.9*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>

                    <!-- Customer ID -->
                    <StackPanel Grid.Column="0"
                                Margin="0,0,12,0">

                        <TextBlock Text="CUSTOMER ID"
                                   Style="{StaticResource FieldLabel}" />

                        <TextBox x:Name="CustomerIdBox"
                                 Height="38"
                                 IsReadOnly="True"
                                 Focusable="False"
                                 Background="#EAF0F8"
                                 Foreground="#4169E1"
                                 FontWeight="SemiBold"
                                 ToolTip="Automatically generated" />
                    </StackPanel>

                    <!-- Full Name -->
                    <StackPanel Grid.Column="1"
                                Margin="0,0,12,0">

                        <TextBlock Text="FULL NAME *"
                                   Style="{StaticResource FieldLabel}" />

                        <TextBox x:Name="FullNameBox"
                                 Height="38"
                                 MaxLength="100" />
                    </StackPanel>

                    <!-- Identity -->
                    <StackPanel Grid.Column="2"
                                Margin="0,0,12,0">

                        <TextBlock Text="IDENTITY NUMBER"
                                   Style="{StaticResource FieldLabel}" />

                        <TextBox x:Name="IdentityNumberBox"
                                 Height="38"
                                 MaxLength="20" />
                    </StackPanel>

                    <!-- Phone -->
                    <StackPanel Grid.Column="3">

                        <TextBlock Text="PHONE NUMBER *"
                                   Style="{StaticResource FieldLabel}" />

                        <TextBox x:Name="PhoneBox"
                                 Height="38"
                                 MaxLength="15" />
                    </StackPanel>
                </Grid>

                <!-- ROW 2:
                     EMAIL | ADDRESS | NATIONALITY -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.6*" />
                        <ColumnDefinition Width="3.2*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>

                    <!-- Email -->
                    <StackPanel Grid.Column="0"
                                Margin="0,0,12,0">

                        <TextBlock Text="EMAIL ADDRESS"
                                   Style="{StaticResource FieldLabel}" />

                        <TextBox x:Name="EmailBox"
                                 Height="38"
                                 MaxLength="100" />
                    </StackPanel>

                    <!-- Address -->
                    <StackPanel Grid.Column="1"
                                Margin="0,0,12,0">

                        <TextBlock Text="ADDRESS"
                                   Style="{StaticResource FieldLabel}" />

                        <TextBox x:Name="AddressBox"
                                 Height="38"
                                 MaxLength="200"
                                 ToolTip="Customer address" />
                    </StackPanel>

                    <!-- Nationality -->
                    <StackPanel Grid.Column="2">

                        <TextBlock Text="NATIONALITY"
                                   Style="{StaticResource FieldLabel}" />

                        <TextBox x:Name="NationalityBox"
                                 Height="38"
                                 MaxLength="50" />
                    </StackPanel>
                </Grid>

                <!-- FORM ACTIONS -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">

                    <Button Content="+ New customer"
                            Style="{StaticResource SecondaryButton}"
                            Click="New_Click"
                            Padding="14,8"
                            Margin="0,0,8,0" />

                    <Button Content="Save customer"
                            Style="{StaticResource PrimaryButton}"
                            Click="Save_Click"
                            Padding="14,8" />
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- GUEST DIRECTORY -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="16"
                MinHeight="170">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- TITLE AND SEARCH -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Guest directory"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#13233C" />

                        <TextBlock Text="Customer records"
                                   FontSize="11"
                                   Foreground="#8793A6" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBox x:Name="SearchBox"
                                 Width="170"
                                 Height="36"
                                 Margin="0,0,8,0"
                                 ToolTip="Search customer information" />

                        <Button Content="Search"
                                Style="{StaticResource PrimaryButton}"
                                Padding="12,7"
                                Click="Search_Click"
                                Margin="0,0,6,0" />

                        <Button Content="All"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,7"
                                Click="ShowAll_Click"
                                Margin="0,0,6,0" />

                        <Button Content="Delete"
                                Style="{StaticResource DangerButton}"
                                Padding="12,7"
                                Click="Delete_Click" />
                    </StackPanel>
                </Grid>

                <!-- CUSTOMER TABLE -->

                <DataGrid x:Name="CustomerGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDF1F7"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SelectionChanged="CustomerGrid_SelectionChanged">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="CUSTOMER ID"
                                            Binding="{Binding CustomerID}"
                                            Width="110"
                                            MinWidth="110" />

                        <DataGridTextColumn Header="FULL NAME"
                                            Binding="{Binding FullName}"
                                            Width="175"
                                            MinWidth="175" />

                        <DataGridTextColumn Header="IDENTITY NUMBER"
                                            Binding="{Binding IdentityNumber}"
                                            Width="150"
                                            MinWidth="150" />

                        <DataGridTextColumn Header="PHONE"
                                            Binding="{Binding Phone}"
                                            Width="125"
                                            MinWidth="125" />

                        <DataGridTextColumn Header="EMAIL"
                                            Binding="{Binding Email}"
                                            Width="200"
                                            MinWidth="200" />

                        <DataGridTextColumn Header="ADDRESS"
                                            Binding="{Binding Address}"
                                            Width="230"
                                            MinWidth="230" />

                        <DataGridTextColumn Header="NATIONALITY"
                                            Binding="{Binding Nationality}"
                                            Width="130"
                                            MinWidth="130" />

                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
