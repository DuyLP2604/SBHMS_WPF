<Window x:Class="SHBMS.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SHBMS.ViewModel"
        xmlns:view="clr-namespace:SHBMS.View"
        Title="SBHMS - Hotel Operations"
        Width="1200"
        Height="760"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="BindingResources.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <DataTemplate DataType="{x:Type vm:BookingsViewModel}"><view:BookingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RoomsViewModel}"><view:RoomsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RoomTypesViewModel}"><view:RoomTypesView /></DataTemplate>

        <Style x:Key="NavButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="#CCD8EA" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="18,15" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Margin"
                    Value="12,4" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#294465" />
                                <Setter Property="Foreground"
                                        Value="White" />
                            </Trigger>

                            <Trigger Property="Tag"
                                     Value="Selected">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#355780" />
                                <Setter Property="Foreground"
                                        Value="White" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#162A46">
            <DockPanel>

                <StackPanel DockPanel.Dock="Bottom"
                            Margin="23,0,23,25">

                    <Border Height="1"
                            Background="#35506C"
                            Margin="0,0,0,18" />

                    <TextBlock Text="FRONT DESK PORTAL"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#91A6C2" />

                    <TextBlock Text="SBHMS"
                               FontSize="12"
                               Foreground="#E4ECF6"
                               Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="25,34,20,32">

                        <Border Background="#4169E1"
                                CornerRadius="11"
                                Width="43"
                                Height="43">

                            <TextBlock Text="H"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Border>

                        <StackPanel Margin="11,2,0,0">
                            <TextBlock Text="SBHMS"
                                       Foreground="White"
                                       FontSize="22"
                                       FontWeight="Bold" />

                            <TextBlock Text="HOTEL MANAGEMENT"
                                       Foreground="#91A6C2"
                                       FontSize="9"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="WORKSPACE"
                               FontSize="10"
                               Foreground="#8299B6"
                               FontWeight="Bold"
                               Margin="27,0,0,12" />

                    <Button x:Name="CustomerNavButton"
                            Content="♟   Customer profiles"
                            Style="{StaticResource NavButton}"
                            Click="Customer_Click" />

                    <Button x:Name="FeedbackNavButton"
                            Content="✉   Guest feedback"
                            Style="{StaticResource NavButton}"
                            Click="Feedback_Click" />

                    <Button x:Name="InvoiceNavButton"
                            Content="$$$  Invoice management"
                            Style="{StaticResource NavButton}"
                            Click="Invoice_Click" />

                    <TextBlock Text="BOOKING &amp; INVENTORY"
                               FontSize="10" Foreground="#8299B6" FontWeight="Bold"
                               Margin="27,28,0,12" />
                    <Button Content="Bookings" Command="{Binding BookingsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="Bookings">
                                        <Setter Property="Tag" Value="Selected" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Rooms" Command="{Binding RoomsCommand}"
                            Visibility="{Binding CanViewRooms, Converter={StaticResource BoolVisibility}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="Rooms">
                                        <Setter Property="Tag" Value="Selected" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Room types" Command="{Binding RoomTypesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKey}" Value="Room types">
                                        <Setter Property="Tag" Value="Selected" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E4EAF3"
                    BorderThickness="0,0,0,1">

                <Grid Margin="27,0">

                    <TextBlock x:Name="BreadcrumbText"
                               Text="{Binding PageTitle}"
                               VerticalAlignment="Center"
                               Foreground="#62748B"
                               FontSize="12" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="Preview role" Foreground="#718096" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                                  Width="110" Padding="8,5" VerticalContentAlignment="Center" />

                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">

                <ContentControl x:Name="MainContent"
                                Visibility="{Binding IsOperationsPage, Converter={StaticResource InverseVisibility}}" />
                <Grid Visibility="{Binding IsOperationsPage, Converter={StaticResource BoolVisibility}}">
                    <ContentControl Content="{Binding CurrentPage}" />
                </Grid>

                <Border x:Name="ToastBorder"
                        Width="320"
                        MaxWidth="320"
                        Padding="16"
                        CornerRadius="12"
                        Background="#E8F7EF"
                        BorderBrush="#D0ECDD"
                        BorderThickness="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,20,25,0"
                        Panel.ZIndex="100"
                        Visibility="Collapsed">

                    <Border.Effect>
                        <DropShadowEffect Color="#344766"
                                          BlurRadius="18"
                                          ShadowDepth="3"
                                          Opacity="0.15" />
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock x:Name="ToastTitle"
                                   Text="Success"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#15875A"
                                   Margin="0,0,0,5" />

                        <TextBlock x:Name="ToastMessage"
                                   Text="Operation completed!"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="#344766" />
                    </StackPanel>
                </Border>

            </Grid>

        </Grid>
    </Grid>
</Window>
