<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SHBMS.View.MainWindow" Title="SBHMS - Hotel Operations" Width="1280" Height="800" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F3F6FB" FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCD8EA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Selected">
                    <Setter Property="Background" Value="#355780"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#162A46">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="22,15">
                    <TextBlock Text="{Binding DisplayName}" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Role}" Foreground="#91A6C2" Margin="0,4,0,14"/>
                    <Button Content="Sign out" Click="SignOut_Click" Padding="12,8"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="SBHMS" Foreground="White" FontSize="27" FontWeight="Bold" Margin="25,30,10,5"/>
                        <TextBlock Text="HOTEL MANAGEMENT" Foreground="#91A6C2" FontSize="10" Margin="25,0,10,25"/>
                        <Button x:Name="CustomerNavButton" Content="Customer profiles" Style="{StaticResource NavButton}" Click="Customer_Click"/>
                        <Button x:Name="BookingNavButton" Content="Bookings" Style="{StaticResource NavButton}" Click="Bookings_Click" Visibility="{Binding CanViewBookings, Converter={StaticResource BoolToVisibility}}"/>
                        <Button x:Name="StayNavButton" Content="Guest stays" Style="{StaticResource NavButton}" Click="Stay_Click"/>
                        <Button x:Name="RoomNavButton" Content="Rooms" Style="{StaticResource NavButton}" Click="Room_Click" Visibility="{Binding CanViewRooms, Converter={StaticResource BoolToVisibility}}"/>
                        <Button x:Name="ServiceRequestNavButton" Content="Booking services" Style="{StaticResource NavButton}" Click="ServiceRequest_Click"/>
                        <Button x:Name="FeedbackNavButton" Content="Guest feedback" Style="{StaticResource NavButton}" Click="Feedback_Click"/>
                        <Button x:Name="InvoiceNavButton" Content="Invoices" Style="{StaticResource NavButton}" Click="Invoice_Click"/>
                        <Button x:Name="RoomTypeNavButton" Content="Room types" Style="{StaticResource NavButton}" Click="RoomTypes_Click" Visibility="{Binding CanViewRooms, Converter={StaticResource BoolToVisibility}}"/>
                        <Button x:Name="StaffNavButton" Content="Staff accounts" Style="{StaticResource NavButton}" Click="Staff_Click" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="White" Padding="22,14">
                <TextBlock Text="{Binding PageTitle}" Foreground="#13233C" FontSize="18" FontWeight="SemiBold"/>
            </Border>
            <ContentControl x:Name="PageHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
        <Border x:Name="ToastBorder" Grid.ColumnSpan="2" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Padding="18" CornerRadius="10" Panel.ZIndex="10" MaxWidth="420">
            <StackPanel>
                <TextBlock x:Name="ToastTitle" FontWeight="Bold"/>
                <TextBlock x:Name="ToastMessage" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
