<UserControl x:Class="SHBMS.View.BookingDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><ResourceDictionary Source="OperationsStyles.xaml"/></UserControl.Resources>
    <TabControl>
        <TabItem Header="Overview"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,12"><TextBlock Text="BOOKING" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding Booking.BookingId}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding Booking.Status}" Foreground="#4169E1" Margin="0,5"/><TextBlock Text="{Binding Booking.BookingDate, StringFormat=dd/MM/yyyy HH:mm}" Style="{StaticResource SmallMuted}"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,12"><TextBlock Text="CUSTOMER" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding Booking.CustomerName}" Style="{StaticResource DetailValue}"/><TextBlock Text="{Binding Booking.CustomerPhone}" Style="{StaticResource DetailValue}"/><TextBlock Text="{Binding CustomerEmail}" Style="{StaticResource SmallMuted}"/><TextBlock Text="{Binding CustomerAddress}" Style="{StaticResource SmallMuted}"/><TextBlock Text="{Binding Nationality}" Style="{StaticResource SmallMuted}"/><TextBlock Text="{Binding IdentityNumber}" Style="{StaticResource SmallMuted}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="CREATED BY" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding Booking.EmployeeName}" Style="{StaticResource DetailValue}"/><TextBlock Text="{Binding Booking.EmployeeId}" Style="{StaticResource SmallMuted}"/><TextBlock Text="{Binding Booking.CancellationReason}" Foreground="#B43848" TextWrapping="Wrap" Margin="0,10"/></StackPanel>
            </Grid>
            <UniformGrid Columns="4" Margin="0,12,0,15"><StackPanel><TextBlock Text="CHECK-IN" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding Booking.CheckInDate, StringFormat=dd/MM/yyyy}"/></StackPanel><StackPanel><TextBlock Text="CHECK-OUT" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding Booking.CheckOutDate, StringFormat=dd/MM/yyyy}"/></StackPanel><StackPanel><TextBlock Text="DEADLINE" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding Booking.CheckInDeadline, StringFormat=dd/MM/yyyy HH:mm}"/></StackPanel><StackPanel><TextBlock Text="NIGHTS / ROOMS" Style="{StaticResource DetailLabel}"/><TextBlock><Run Text="{Binding Booking.NumberOfNights}"/><Run Text=" / "/><Run Text="{Binding Booking.TotalRooms}"/></TextBlock></StackPanel></UniformGrid>
            <DataGrid ItemsSource="{Binding Rooms}" Height="145"><DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding RoomTypeName}" Width="*"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="65"/><DataGridTextColumn Header="Nightly rate" Binding="{Binding UnitPrice, StringFormat=N0}" Width="130"/><DataGridTextColumn Header="Nights" Binding="{Binding NumberOfNights}" Width="70"/><DataGridTextColumn Header="Line total" Binding="{Binding LineTotal, StringFormat=N0}" Width="135"/></DataGrid.Columns></DataGrid>
            <UniformGrid Columns="3" Margin="0,15,0,0"><StackPanel><TextBlock Text="ROOMS (VND)" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding Booking.RoomSubtotal, StringFormat=N0}" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="SERVICES (VND)" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding Booking.ServiceSubtotal, StringFormat=N0}" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="TOTAL (VND)" Style="{StaticResource DetailLabel}"/><TextBlock Text="{Binding Booking.TotalEstimatedAmount, StringFormat=N0}" FontWeight="Bold" Foreground="#4169E1"/></StackPanel></UniformGrid>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Assigned rooms"><DataGrid ItemsSource="{Binding Assignments}" Margin="8"><DataGrid.Columns><DataGridTextColumn Header="Room" Binding="{Binding RoomNumber}" Width="90"/><DataGridTextColumn Header="Type" Binding="{Binding RoomTypeName}" Width="*"/><DataGridTextColumn Header="Assigned by" Binding="{Binding EmployeeName}" Width="170"/><DataGridTextColumn Header="Assigned at" Binding="{Binding AssignedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/></DataGrid.Columns></DataGrid></TabItem>
        <TabItem Header="Services"><DataGrid ItemsSource="{Binding Services}" Margin="8"><DataGrid.Columns><DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="*"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/><DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat=N0}" Width="130"/><DataGridTextColumn Header="Amount" Binding="{Binding LineTotal, StringFormat=N0}" Width="140"/></DataGrid.Columns></DataGrid></TabItem>
        <TabItem Header="Payments"><DataGrid ItemsSource="{Binding Payments}" Margin="8"><DataGrid.Columns><DataGridTextColumn Header="Payment" Binding="{Binding PaymentId}" Width="90"/><DataGridTextColumn Header="Time" Binding="{Binding PaymentTime, StringFormat=dd/MM/yyyy HH:mm}" Width="155"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N0}" Width="125"/><DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="115"/><DataGridTextColumn Header="Collected by" Binding="{Binding EmployeeName}" Width="160"/><DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
        <TabItem Header="Invoices"><DataGrid ItemsSource="{Binding Invoices}" Margin="8"><DataGrid.Columns><DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceId}" Width="100"/><DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat=dd/MM/yyyy HH:mm}" Width="170"/><DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=N0}" Width="150"/><DataGridTextColumn Header="Issued by" Binding="{Binding EmployeeName}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
    </TabControl>
</UserControl>
