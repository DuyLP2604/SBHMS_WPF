<UserControl x:Class="SHBMS.View.ServiceAvailabilityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F6FB"
    FontFamily="Segoe UI">

    <UserControl.Style>
        <Style TargetType="UserControl"><Style.Triggers>
            <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
        </Style.Triggers></Style>
    </UserControl.Style>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter
                x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Service Availability"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="#13233C"/>

                <TextBlock
                    Text="View and manage hotel service availability."
                    FontSize="12"
                    Foreground="#718096"
                    Margin="0,4,0,0"/>


            </StackPanel>
        </Grid>

        <!-- SEARCH / FILTER -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="12"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="85"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Height="34"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         ToolTip="Search by service ID or name"
                         Text="{Binding SearchText,
                              UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Grid.Column="1"
                          Height="34"
                          Margin="0,0,10,0"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding StatusFilter,
                              Mode=TwoWay}"/>

                <Button Grid.Column="2"
                        Content="Reset"
                        Command="{Binding ResetCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="3"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"/>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*" MinWidth="400"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: SERVICE LIST -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Service List"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,8"/>

                    <WrapPanel Grid.Row="1"
                               Margin="0,0,0,10">

                        <TextBlock Text="Total: "
                                   Foreground="#64748B"/>

                        <TextBlock Text="{Binding TotalServices}"
                                   FontWeight="Bold"
                                   Margin="0,0,14,0"/>

                        <TextBlock Text="Available: "
                                   Foreground="#64748B"/>

                        <TextBlock Text="{Binding AvailableServices}"
                                   Foreground="#15803D"
                                   FontWeight="Bold"
                                   Margin="0,0,14,0"/>

                        <TextBlock Text="Unavailable: "
                                   Foreground="#64748B"/>

                        <TextBlock Text="{Binding UnavailableServices}"
                                   Foreground="#DC2626"
                                   FontWeight="Bold"/>
                    </WrapPanel>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Services}"
                              SelectedItem="{Binding SelectedService,
                                  Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowHeight="40"
                              ColumnHeaderHeight="42"
                              HeadersVisibility="Column"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="ID"
                                Binding="{Binding ServiceId}"
                                Width="60"/>

                            <DataGridTextColumn
                                Header="SERVICE"
                                Binding="{Binding ServiceName}"
                                Width="*"
                                MinWidth="130"/>

                            <DataGridTextColumn
                                Header="PRICE"
                                Binding="{Binding UnitPrice,
                                    StringFormat={}{0:N0}}"
                                Width="95"/>

                            <DataGridTextColumn
                                Header="STATUS"
                                Binding="{Binding AvailabilityStatus}"
                                Width="105"/>

                            <DataGridTextColumn
                                Header="STOCK"
                                Binding="{Binding StockDisplay}"
                                Width="100"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- RIGHT: SERVICE DETAILS -->
            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="16">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Service Details"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel>

                            <!-- SERVICE INFO -->
                            <TextBlock Text="SERVICE ID"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,4,0,3"/>

                            <TextBlock
                                Text="{Binding SelectedService.ServiceId,
                                    TargetNullValue=Select a service}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#13233C"/>

                            <TextBlock Text="SERVICE NAME"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,10,0,3"/>

                            <TextBlock
                                Text="{Binding SelectedService.ServiceName}"
                                Foreground="#13233C"
                                TextWrapping="Wrap"/>

                            <TextBlock Text="UNIT PRICE"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,10,0,3"/>

                            <TextBlock
                                Text="{Binding SelectedService.UnitPrice,
                                    StringFormat={}{0:N0} VND}"
                                Foreground="#13233C"/>

                            <TextBlock Text="CURRENT STATUS"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,10,0,3"/>

                            <TextBlock
                                Text="{Binding SelectedService.AvailabilityStatus}"
                                FontWeight="SemiBold"
                                Foreground="#2563EB"/>

                            <TextBlock Text="CURRENT STOCK"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,10,0,3"/>

                            <TextBlock
                                Text="{Binding SelectedService.StockDisplay}"
                                Foreground="#13233C"/>

                            <Separator Margin="0,12,0,12"/>

                            <!-- UC-19: STAFF ONLY -->
                            <StackPanel
                                Visibility="{Binding CanManage,
                                    Converter={StaticResource BoolToVisibility}}">

                                <TextBlock
                                    Text="Update Availability"
                                    Style="{StaticResource SectionTitle}"
                                    Margin="0,0,0,10"/>

                                <CheckBox Content="Available"
                                          IsChecked="{Binding SelectedAvailability,
                                              Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,10"/>

                                <TextBlock Text="STOCK QUANTITY"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,5"/>

                                <TextBox Height="36"
                                         Text="{Binding StockQuantityText,
                                             UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Leave blank if stock is not tracked"/>

                                <TextBlock
                                    Text="Leave blank if stock is not tracked."
                                    FontSize="11"
                                    Foreground="#94A3B8"
                                    Margin="0,5,0,0"/>

                                <Button Content="Save Changes"
                                        Command="{Binding UpdateCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
